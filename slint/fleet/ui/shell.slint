import { AtlasIcon, IconName, AtlasTypography } from "@atlas-ui/stable.slint";
import { FleetTheme } from "theme.slint";
import { InstrumentLabel, FleetButton, FleetStatus } from "components.slint";

// F-01 "Formation": three coordinated units sharing one operational core.
// Kept as a native vector mark so it stays crisp at sidebar scale.
export component FleetBrandMark inherits Rectangle {
    background: #00000000;

    Path {
        x: 0px; y: 7px; width: 14px; height: 14px;
        viewbox-width: 14; viewbox-height: 14;
        fill: #00000000; stroke: FleetTheme.cyan; stroke-width: 1.4px;
        MoveTo { x: 7; y: 0; } LineTo { x: 14; y: 7; }
        LineTo { x: 7; y: 14; } LineTo { x: 0; y: 7; } Close { }
    }
    Path {
        x: 8px; y: 1px; width: 22px; height: 22px;
        viewbox-width: 22; viewbox-height: 22;
        fill: #13d3df1f; stroke: FleetTheme.cyan; stroke-width: 1.6px;
        MoveTo { x: 11; y: 0; } LineTo { x: 22; y: 11; }
        LineTo { x: 11; y: 22; } LineTo { x: 0; y: 11; } Close { }
    }
    Path {
        x: 24px; y: 7px; width: 14px; height: 14px;
        viewbox-width: 14; viewbox-height: 14;
        fill: #00000000; stroke: FleetTheme.cyan; stroke-width: 1.4px;
        MoveTo { x: 7; y: 0; } LineTo { x: 14; y: 7; }
        LineTo { x: 7; y: 14; } LineTo { x: 0; y: 7; } Close { }
    }
    Rectangle {
        x: 16px; y: 9px; width: 6px; height: 6px;
        border-radius: 3px; background: FleetTheme.cyan;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <IconName> icon-name;
    in property <string> count;
    in property <bool> selected;
    callback clicked();
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    height: 40px;
    background: root.selected ? #17262d : pointer.has-hover ? #131f25 : #00000000;
    if root.selected: Rectangle { x: parent.width - 2px; y: 0px; width: 2px; height: parent.height; background: FleetTheme.cyan; }
    AtlasIcon { x: 17px; y: 12px; size: 14px; name: root.icon-name; icon-color: root.selected ? FleetTheme.cyan : #617580; }
    Text { x: 43px; width: parent.width - 78px; text: root.label; color: root.selected ? #c8d9df : #738791; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: root.selected ? 600 : 400; vertical-alignment: center; }
    if root.count != "": Rectangle { x: parent.width - 34px; y: 10px; width: 21px; height: 18px; border-width: 1px; border-color: root.selected ? #315c64 : #293b44; background: #111a20;
        Text { x: 0px; width: parent.width; text: root.count; color: root.selected ? FleetTheme.cyan : #607681; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
    }
    pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

export component FleetSidebar inherits Rectangle {
    in-out property <int> current-page: 0;
    callback navigate(int);
    width: FleetTheme.sidebar-width;
    background: FleetTheme.sidebar;
    border-width: 0px;
    Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: FleetTheme.border; }

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: FleetTheme.topbar-height; border-width: 0px;
        FleetBrandMark { x: 17px; y: 22px; width: 38px; height: 24px; }
        Text { x: 65px; y: 14px; height: 19px; text: "ATLAS"; color: FleetTheme.text; font-family: AtlasTypography.font-sans; font-size: 15px; font-weight: 700; letter-spacing: 2px; vertical-alignment: center; }
        Text { x: 65px; y: 35px; height: 14px; text: "FLEET"; color: FleetTheme.cyan; font-family: AtlasTypography.font-mono; font-size: 9px; letter-spacing: 2px; vertical-alignment: center; }
        Text { x: parent.width - 48px; y: 21px; width: 34px; height: 15px; text: "FC—01"; color: #455b66; font-family: AtlasTypography.font-mono; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: FleetTheme.border; }
    }

    Rectangle {
        x: 0px; y: FleetTheme.topbar-height; width: parent.width; height: 93px;
        InstrumentLabel { x: 15px; y: 12px; width: parent.width - 30px; text: "FLEET CONTROL"; }
        Rectangle { x: 13px; y: 34px; width: parent.width - 26px; height: 48px; border-width: 1px; border-color: #2a3d46; background: #111a20;
            Rectangle { x: 9px; y: 11px; width: 25px; height: 25px; border-width: 1px; border-color: #315761; background: #16252b;
                Text { x: 0px; width: parent.width; text: "DMO"; color: FleetTheme.cyan; font-family: AtlasTypography.font-mono; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { x: 43px; y: 9px; width: 125px; height: 15px; text: "Demo Environment"; color: #bac9cf; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 600; vertical-alignment: center; }
            Text { x: 43px; y: 26px; width: 125px; height: 13px; text: "26 sample devices"; color: FleetTheme.muted; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
            AtlasIcon { x: parent.width - 19px; y: 19px; size: 10px; name: IconName.chevron-down; icon-color: #5c707a; }
        }
    }

    InstrumentLabel { x: 16px; y: 173px; width: parent.width - 32px; text: "OPERATIONS"; }
    VerticalLayout {
        x: 0px; y: 193px; width: parent.width; height: 280px; spacing: 0px;
        NavItem { label: "Overview"; icon-name: IconName.activity; selected: root.current-page == 0; clicked => { root.navigate(0); } }
        NavItem { label: "Devices"; icon-name: IconName.cpu; count: "26"; selected: root.current-page == 1; clicked => { root.navigate(1); } }
        NavItem { label: "Topology"; icon-name: IconName.webhook; selected: root.current-page == 2; clicked => { root.navigate(2); } }
        NavItem { label: "Deployments"; icon-name: IconName.download; selected: root.current-page == 3; clicked => { root.navigate(3); } }
        NavItem { label: "Metrics"; icon-name: IconName.analytics; selected: root.current-page == 4; clicked => { root.navigate(4); } }
        NavItem { label: "Alerts"; icon-name: IconName.warning; count: "3"; selected: root.current-page == 5; clicked => { root.navigate(5); } }
        NavItem { label: "Logs"; icon-name: IconName.terminal; selected: root.current-page == 6; clicked => { root.navigate(6); } }
    }
    InstrumentLabel { x: 16px; y: 494px; width: parent.width - 32px; text: "SYSTEM"; }
    NavItem { x: 0px; y: 516px; width: parent.width; label: "Automation"; icon-name: IconName.play; selected: root.current-page == 7; clicked => { root.navigate(7); } }
    NavItem { x: 0px; y: 556px; width: parent.width; label: "Settings"; icon-name: IconName.settings; selected: root.current-page == 8; clicked => { root.navigate(8); } }

    Rectangle {
        x: 13px; y: parent.height - 105px; width: parent.width - 26px; height: 91px;
        border-width: 1px; border-color: #263b44; background: #111b21;
        FleetStatus { x: 10px; y: 8px; label: "CONNECTED"; tone: 0; }
        AtlasIcon { x: parent.width - 23px; y: 11px; size: 12px; name: IconName.activity; icon-color: FleetTheme.green; }
        Text { x: 10px; y: 31px; width: parent.width - 20px; height: 15px; text: "Control Server"; color: #b8c8ce; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 600; vertical-alignment: center; }
        Text { x: 10px; y: 48px; width: parent.width - 20px; height: 13px; text: "control-01.example.invalid"; color: FleetTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; overflow: elide; }
        Rectangle { y: 66px; width: parent.width; height: 1px; background: FleetTheme.border; }
        Text { x: 10px; y: 70px; text: "v1.4.2"; color: #526873; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
        Text { x: 0px; width: parent.width - 10px; y: 70px; text: "12 ms"; color: #526873; font-family: AtlasTypography.font-mono; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

export component FleetTopbar inherits Rectangle {
    in property <int> current-page: 0;
    callback add-device();
    in property <string> page-name: root.current-page == 0 ? "Overview"
        : root.current-page == 1 ? "Devices" : root.current-page == 2 ? "Topology"
        : root.current-page == 3 ? "Deployments" : root.current-page == 4 ? "Metrics"
        : root.current-page == 5 ? "Alerts" : root.current-page == 6 ? "Logs"
        : root.current-page == 7 ? "Automation" : "Settings";
    private property <string> page-code: root.current-page == 0 ? "OVERVIEW"
        : root.current-page == 1 ? "DEVICES" : root.current-page == 2 ? "TOPOLOGY"
        : root.current-page == 3 ? "DEPLOYMENTS" : root.current-page == 4 ? "METRICS"
        : root.current-page == 5 ? "ALERTS" : root.current-page == 6 ? "LOGS"
        : root.current-page == 7 ? "AUTOMATION" : "SETTINGS";
    height: FleetTheme.topbar-height;
    background: #10171d;
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: FleetTheme.border; }
    Text { x: 24px; y: 9px; height: 14px; text: "ATLAS FLEET  /  " + root.page-code; color: #516772; font-family: AtlasTypography.font-mono; font-size: 8px; letter-spacing: 0.5px; vertical-alignment: center; }
    Text { x: 24px; y: 26px; height: 25px; text: root.current-page == 0 ? "Fleet Overview" : root.page-name; color: FleetTheme.text; font-family: AtlasTypography.font-sans; font-size: 16px; font-weight: 650; vertical-alignment: center; }
    Rectangle { x: 228px; y: 16px; width: min(330px, parent.width - 665px); height: 36px; border-width: 1px; border-color: #293b44; background: #0d1419;
        AtlasIcon { x: 9px; y: 10px; size: 12px; name: IconName.search; icon-color: FleetTheme.muted; }
        Text { x: 29px; width: parent.width - 68px; text: "Search demo devices..."; color: #536a75; font-family: AtlasTypography.font-sans; font-size: 10px; vertical-alignment: center; }
        Rectangle { x: parent.width - 35px; y: 7px; width: 26px; height: 18px; border-width: 1px; border-color: #2d3e47; background: #151e24;
            Text { x: 0px; width: parent.width; text: "⌘K"; color: #607681; font-family: AtlasTypography.font-mono; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    FleetStatus { x: parent.width - 315px; y: 26px; width: 75px; label: "SIMULATED"; tone: 0; tone-color: FleetTheme.cyan; }
    FleetButton { x: parent.width - 234px; y: 17px; width: 78px; height: 35px; text: "Refresh"; show-icon: true; icon-name: IconName.refresh; }
    FleetButton { x: parent.width - 149px; y: 17px; width: 103px; height: 35px; text: "Add Device"; show-icon: true; icon-name: IconName.add; accent: true; clicked => { root.add-device(); } }
    Rectangle { x: parent.width - 37px; y: 18px; width: 29px; height: 29px; border-width: 1px; border-color: #31515a; border-radius: 15px; background: #17262d;
        Text { x: 0px; width: parent.width; text: "DA"; color: FleetTheme.cyan; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}
