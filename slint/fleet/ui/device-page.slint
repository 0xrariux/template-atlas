import { AtlasIcon, IconName, AtlasTypography } from "@atlas-ui/stable.slint";
import { FleetTheme } from "theme.slint";
import { DeviceRecord } from "models.slint";
import {
    FleetSurface, SummaryCell, ToolField, FleetTabs, FleetStatus, FleetMeter,
    InstrumentLabel, FleetButton, FleetTableRow
} from "components.slint";

component RegistryRow inherits FleetTableRow {
    in property <DeviceRecord> device;
    row-label: root.device.id;
    height: 64px;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: FleetTheme.border-soft; }
    Rectangle { x: 10px; y: 18px; width: 27px; height: 27px; border-width: 1px; border-color: #2d515b; background: #14242b;
        Text { x: 0px; width: parent.width; text: "DV"; color: FleetTheme.cyan; font-family: AtlasTypography.font-mono; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 45px; y: 9px; width: parent.width * 0.14; height: 16px; text: root.device.id; color: #c4cfd4; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 600; vertical-alignment: center; overflow: elide; }
    Text { x: 45px; y: 28px; width: parent.width * 0.14; height: 14px; text: root.device.model; color: #526873; font-family: AtlasTypography.font-sans; font-size: 8px; vertical-alignment: center; overflow: elide; }
    FleetStatus { x: parent.width * 0.205; y: 24px; width: parent.width * 0.09; label: root.device.state; tone: root.device.tone; }
    Text { x: parent.width * 0.31; width: parent.width * 0.16; text: root.device.location; color: #657a85; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width * 0.48; width: parent.width * 0.13; text: root.device.ip; color: #657a85; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; overflow: elide; }
    Rectangle { x: parent.width * 0.625; y: 22px; width: parent.width * 0.10; height: 20px;
        Text { x: 0px; width: 28px; text: root.device.cpu + "%"; color: root.device.cpu > 75 ? FleetTheme.warning : #8ea0ad; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
        FleetMeter { x: 36px; y: 9px; width: parent.width - 36px; value: root.device.cpu; meter-color: root.device.cpu > 75 ? FleetTheme.warning : FleetTheme.cyan; }
    }
    Text { x: parent.width * 0.74; width: parent.width * 0.08; text: root.device.memory; color: #70848e; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width * 0.83; width: parent.width * 0.06; text: root.device.temp == 0 ? "—" : root.device.temp + "°C"; color: root.device.temp > 65 ? FleetTheme.warning : #70848e; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
    Text { x: parent.width * 0.90; width: parent.width * 0.05; text: root.device.disk + "%"; color: #70848e; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
    AtlasIcon { x: parent.width - 20px; y: 27px; size: 9px; name: IconName.chevron-right; icon-color: #506671; }
}

component InventoryInspector inherits FleetSurface {
    in property <DeviceRecord> device;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 70px; background: #151e24;
        InstrumentLabel { x: 13px; y: 8px; width: 180px; text: "DEVICE INSPECTOR"; }
        Text { x: 13px; y: 25px; width: parent.width - 50px; height: 16px; text: root.device.id; color: FleetTheme.text; font-family: AtlasTypography.font-mono; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        Text { x: 13px; y: 44px; text: root.device.ip; color: FleetTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
        AtlasIcon { x: parent.width - 27px; y: 21px; size: 12px; name: IconName.close; icon-color: #5c717c; }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: FleetTheme.border; }
    }
    Rectangle { y: 70px; width: parent.width; height: 70px;
        Rectangle { x: 13px; y: 17px; width: 34px; height: 34px; border-width: 1px; border-color: #2d505b; background: #14242b;
            AtlasIcon { x: 9px; y: 9px; size: 16px; name: root.device.kind == "ARM64" ? IconName.cpu : IconName.database; icon-color: FleetTheme.cyan; }
        }
        Text { x: 57px; y: 14px; width: parent.width - 145px; height: 17px; text: root.device.model; color: #c4cfd4; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        Text { x: 57px; y: 35px; width: parent.width - 145px; height: 14px; text: root.device.kind + " · " + root.device.location; color: FleetTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; overflow: elide; }
        FleetStatus { x: parent.width - 88px; y: 25px; width: 76px; label: root.device.state; tone: root.device.tone; align-right: true; }
    }
    Rectangle { x: 13px; y: 141px; width: parent.width - 26px; height: 32px;
        HorizontalLayout { spacing: 5px;
            FleetButton { text: "SSH"; show-icon: true; icon-name: IconName.terminal; horizontal-stretch: 1; }
            FleetButton { text: "Restart"; show-icon: true; icon-name: IconName.refresh; horizontal-stretch: 1; }
            FleetButton { text: "Deploy"; show-icon: true; icon-name: IconName.download; horizontal-stretch: 1; }
        }
    }
    Rectangle { x: 13px; y: 190px; width: parent.width - 26px; height: 166px; border-width: 0px;
        InstrumentLabel { x: 0px; y: 0px; width: parent.width; text: "RESOURCE UTILIZATION"; }
        InstrumentLabel { x: 0px; y: 25px; width: 60px; text: "CPU"; }
        Text { x: 0px; y: 25px; width: parent.width; text: root.device.cpu + "%"; color: #aebdc3; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; }
        FleetMeter { y: 45px; width: parent.width; value: root.device.cpu; meter-color: root.device.cpu > 75 ? FleetTheme.warning : FleetTheme.cyan; }
        InstrumentLabel { x: 0px; y: 65px; width: 60px; text: "MEMORY"; }
        Text { x: 0px; y: 65px; width: parent.width; text: root.device.memory; color: #aebdc3; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; }
        FleetMeter { y: 85px; width: parent.width; value: root.device.memory-percent; }
        InstrumentLabel { x: 0px; y: 105px; width: 60px; text: "DISK"; }
        Text { x: 0px; y: 105px; width: parent.width; text: root.device.disk + "%"; color: #aebdc3; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; }
        FleetMeter { y: 125px; width: parent.width; value: root.device.disk; }
    }
    Rectangle { x: 13px; y: 374px; width: parent.width - 26px; height: 136px;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: FleetTheme.border; }
        InstrumentLabel { x: 0px; y: 13px; width: parent.width; text: "DEVICE METADATA"; }
        InstrumentLabel { x: 0px; y: 39px; width: 100px; text: "ARCHITECTURE"; }
        Text { x: 0px; y: 39px; width: parent.width; text: root.device.kind; color: #91a1a8; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; }
        InstrumentLabel { x: 0px; y: 64px; width: 100px; text: "AGENT"; }
        Text { x: 0px; y: 64px; width: parent.width; text: "v1.4.2"; color: #91a1a8; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; }
        InstrumentLabel { x: 0px; y: 89px; width: 100px; text: "LAST SEEN"; }
        Text { x: 0px; y: 89px; width: parent.width; text: root.device.tone == 3 ? "32m ago" : "12s ago"; color: #91a1a8; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; }
    }
    FleetButton { x: 13px; y: parent.height - 42px; width: parent.width - 26px; text: "Open device workspace"; accent: true; show-icon: true; icon-name: IconName.chevron-right; }
}

export component DevicesPage inherits Rectangle {
    in property <[DeviceRecord]> devices;
    in property <string> capture-state;
    in-out property <int> filter: root.capture-state == "devices-filter-warning" || root.capture-state == "devices-selected-warning" ? 2 : 0;
    in-out property <int> selected-device: root.capture-state == "devices-selected-warning" ? 1 : 0;
    Rectangle {
        x: 24px; y: 22px; width: parent.width - 48px; height: parent.height - 44px;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 66px;
            InstrumentLabel { x: 0px; y: 0px; width: 240px; text: "INVENTORY / 26 SAMPLE DEVICES"; }
            Text { x: 0px; y: 18px; height: 30px; text: "Device registry"; color: FleetTheme.text; font-family: AtlasTypography.font-sans; font-size: 25px; font-weight: 700; vertical-alignment: center; }
            Text { x: 0px; y: 52px; text: "Monitor, filter, and operate the connected demo fleet."; color: #627782; font-family: AtlasTypography.font-sans; font-size: 10px; vertical-alignment: center; }
            FleetButton { x: parent.width - 126px; y: 15px; width: 126px; text: "Add Device"; show-icon: true; icon-name: IconName.add; accent: true; }
        }
        GridLayout { y: 98px; width: parent.width; height: 100px; spacing: 0px;
            SummaryCell { row:0; col:0; label:"TOTAL DEVICES"; value:"26"; detail:"4 SITES"; icon-name:IconName.cpu; }
            SummaryCell { row:0; col:1; label:"ONLINE"; value:"24"; detail:"92.3% CONNECTED"; icon-name:IconName.activity; tone-color:FleetTheme.green; }
            SummaryCell { row:0; col:2; label:"REQUIRES ATTENTION"; value:"3"; detail:"2 WARN · 1 OFFLINE"; icon-name:IconName.warning; tone-color:FleetTheme.warning; }
            SummaryCell { row:0; col:3; label:"AGENT VERSION"; value:"1.4.2"; detail:"24 UP TO DATE"; icon-name:IconName.download; }
        }
        FleetSurface { y: 207px; width: parent.width; height: 54px;
            ToolField { x: 8px; y: 9px; width: parent.width - 490px; height: 35px; text: "Search devices, models, locations..."; icon-name: IconName.search; }
            FleetTabs { x: parent.width - 473px; y: 9px; width: 260px; height: 35px; labels: ["ALL", "ONLINE", "WARNING", "OFFLINE"]; selected-index <=> root.filter; }
            FleetButton { x: parent.width - 205px; y: 9px; width: 122px; height: 35px; text: "All locations"; show-icon: true; icon-name: IconName.filter; }
            FleetButton { x: parent.width - 75px; y: 9px; width: 67px; height: 35px; text: "Sort"; }
        }
        Rectangle { y: 270px; width: parent.width; height: parent.height - 270px;
            FleetSurface {
                x: 0px; y: 0px; width: parent.width - 329px; height: parent.height;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 35px; background: #151e24;
                    InstrumentLabel { x: 10px; width: parent.width * 0.20; text: "DEVICE"; }
                    InstrumentLabel { x: parent.width * 0.205; width: parent.width * 0.09; text: "STATE"; }
                    InstrumentLabel { x: parent.width * 0.31; width: parent.width * 0.16; text: "LOCATION"; }
                    InstrumentLabel { x: parent.width * 0.48; width: parent.width * 0.13; text: "ADDRESS"; }
                    InstrumentLabel { x: parent.width * 0.625; width: parent.width * 0.10; text: "CPU"; }
                    InstrumentLabel { x: parent.width * 0.74; width: parent.width * 0.08; text: "MEMORY"; }
                    InstrumentLabel { x: parent.width * 0.83; width: parent.width * 0.06; text: "TEMP"; }
                    InstrumentLabel { x: parent.width * 0.90; width: parent.width * 0.05; text: "DISK"; }
                    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: FleetTheme.border; }
                }
                for device[index] in root.devices: RegistryRow {
                    private property <bool> matches: root.filter == 0 || (root.filter == 1 && device.tone == 0) || (root.filter == 2 && device.tone == 1) || (root.filter == 3 && device.tone == 3);
                    private property <int> display-index: root.filter == 0 ? index : root.filter == 1 ? (index == 0 ? 0 : index == 2 ? 1 : 2) : 0;
                    visible: self.matches; y: 35px + self.display-index * 64px; width: parent.width;
                    device: device; selected: root.selected-device == index;
                    clicked => { root.selected-device = index; }
                }
                Rectangle { y: parent.height - 36px; width: parent.width; height: 36px; background: #111920;
                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: FleetTheme.border; }
                    Text { x: 10px; text: root.filter == 0 ? "SHOWING 6 OF 26 DEVICES" : "FILTERED DEVICE INVENTORY"; color: FleetTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    Text { x: 0px; width: parent.width - 10px; text: "01  02  03  ›"; color: FleetTheme.cyan; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            InventoryInspector { x: parent.width - 320px; y: 0px; width: 320px; height: parent.height; device: root.devices[root.selected-device]; }
        }
    }
}
