import {
    AtlasButton, ButtonTone, AtlasIconButton, IconButtonTone,
    AtlasIcon, IconName, IconTone, AtlasBadge, AtlasStatusIndicator, BadgeTone,
    AtlasMetricCard, ValueTone, Surface, AtlasTypography, AtlasShape,
    Density
} from "@atlas-ui/stable.slint";
import { ActionArea, AtlasProgressBar } from "@atlas-ui/preview-nonresponsive.slint";
import { CommandTheme } from "theme.slint";
import { MetricRecord } from "models.slint";

export component CommandSurface inherits Surface {
    raised: false;
    background: CommandTheme.surface;
    border-color: CommandTheme.border;
    border-width: 1px;
    border-radius: CommandTheme.surface-radius;
}

export component CommandButton inherits AtlasButton {
    in property <bool> primary: false;
    density: Density.compact;
    height: 35px;
    tone: root.primary ? ButtonTone.primary : ButtonTone.neutral;
    border-radius: 5px;
    border-color: root.primary ? #354add : CommandTheme.border-strong;
    background: root.primary
        ? (root.pressed ? #2d40c7 : root.hovered ? CommandTheme.accent-hover : CommandTheme.accent)
        : (root.pressed ? #f0f1f3 : root.hovered ? #fafafa : #ffffff);
    animate background { duration: 110ms; }
    animate border-color { duration: 110ms; }
}

export component CommandIconButton inherits AtlasIconButton {
    density: Density.compact;
    height: 34px;
    width: 34px;
    border-radius: 5px;
    border-color: #00000000;
    background: root.pressed ? #e8eaed : root.hovered ? #f0f1f3 : #00000000;
    tone: IconButtonTone.neutral;
}

export component CommandBadge inherits AtlasBadge {
    in property <int> status-tone: 0;
    tone: status-tone == 0 ? BadgeTone.healthy
        : status-tone == 1 ? BadgeTone.warning
        : status-tone == 2 ? BadgeTone.neutral : BadgeTone.danger;
    dot: true;
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <IconName> icon-name: IconName.grid;
    in property <bool> selected: false;
    in property <string> count;
    callback clicked();

    height: 39px;
    border-radius: 5px;
    background: root.selected ? CommandTheme.sidebar-selected
        : action.hovered ? #1d2025 : #00000000;
    animate background { duration: 120ms; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { action.trigger(); }

    if root.selected: Rectangle {
        x: -12px;
        y: 9px;
        width: 3px;
        height: 21px;
        background: #6477ff;
    }
    AtlasIcon {
        x: 11px;
        y: 11px;
        size: 16px;
        name: root.icon-name;
        icon-color: root.selected ? #f8f9fb : #8e949e;
    }
    Text {
        x: 39px;
        width: parent.width - 72px;
        text: root.label;
        color: root.selected ? #ffffff : #8e949e;
        font-family: AtlasTypography.font-sans;
        font-size: 12px;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.count != "": Rectangle {
        x: parent.width - 30px;
        y: 10px;
        width: 19px;
        height: 18px;
        border-radius: 9px;
        background: #3c2427;
        Text {
            text: root.count;
            color: #ef8a8a;
            font-family: AtlasTypography.font-sans;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    action := ActionArea {
        accessible-name: root.label;
        activated => { root.clicked(); }
    }
}

export component PageRule inherits Rectangle {
    in property <string> index;
    height: 10px;
    Text {
        x: 0px;
        width: 45px;
        horizontal-alignment: left;
        text: "OPS / " + root.index;
        color: #a0a5ad;
        font-family: AtlasTypography.font-sans;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1.25px;
    }
    Rectangle {
        x: 59px;
        y: 4px;
        width: parent.width - 59px;
        height: 1px;
        background: CommandTheme.border;
    }
}

export component PageHeading inherits Rectangle {
    in property <string> eyebrow;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> operational: false;

    height: 77px;
    eyebrow-label := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 10px;
        text: root.eyebrow;
        color: #777e88;
        font-family: AtlasTypography.font-sans;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1.05px;
        horizontal-alignment: left;
    }
    AtlasStatusIndicator {
        x: eyebrow-label.preferred-width + 8px;
        y: 3px;
        width: 5px;
        height: 5px;
        label: root.operational ? "System operational" : root.eyebrow + " status";
        tone: root.operational ? BadgeTone.healthy : BadgeTone.live;
        indicator-color: root.operational ? CommandTheme.success : CommandTheme.accent;
    }
    if root.operational: Text {
        x: eyebrow-label.preferred-width + 20px;
        y: 0px;
        width: 90px;
        height: 10px;
        text: "OPERATIONAL";
        color: #777e88;
        font-family: AtlasTypography.font-sans;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1.05px;
        horizontal-alignment: left;
    }
    Text {
        x: 0px;
        y: 18px;
        width: parent.width;
        height: 37px;
        text: root.title;
        color: CommandTheme.text;
        font-family: AtlasTypography.font-display;
        font-size: 30px;
        font-weight: 660;
        letter-spacing: -1.35px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    Text {
        x: 0px;
        y: 58px;
        width: parent.width;
        height: 15px;
        text: root.subtitle;
        color: CommandTheme.secondary;
        font-family: AtlasTypography.font-sans;
        font-size: 11px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
}

export component SectionTitle inherits Rectangle {
    in property <string> index;
    in property <string> title;
    in property <string> subtitle;
    width: 280px;
    height: root.subtitle == "" ? 24px : 43px;
    Rectangle {
        x: 0px; y: 0px; width: 27px; height: 19px;
        border-radius: 4px;
        background: #f0f2ff;
        Text {
            width: parent.width; height: parent.height;
            horizontal-alignment: center; vertical-alignment: center;
            text: root.index;
            color: CommandTheme.accent;
            font-family: AtlasTypography.font-mono;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 0.7px;
        }
    }
    Text {
        x: 36px;
        y: 0px;
        width: parent.width - 36px;
        height: 19px;
        horizontal-alignment: left;
        vertical-alignment: center;
        text: root.title;
        color: CommandTheme.text;
        font-family: AtlasTypography.font-sans;
        font-size: 13px;
        font-weight: 700;
    }
    if root.subtitle != "": Text {
        x: 36px;
        y: 25px;
        width: parent.width - 36px;
        height: 14px;
        horizontal-alignment: left;
        vertical-alignment: center;
        text: root.subtitle;
        color: CommandTheme.muted;
        font-family: AtlasTypography.font-sans;
        font-size: 9px;
    }
}

export component SecondaryHeader inherits Rectangle {
    in property <string> index;
    in property <string> eyebrow;
    in property <string> title;
    in property <string> subtitle;
    in property <string> primary-label;
    in property <IconName> primary-icon: IconName.add;
    callback primary-clicked();
    private property <length> primary-width: root.primary-label == "" ? 0px
        : root.primary-label == "Add Integration" ? 136px : 116px;

    height: 110px;
    PageRule { x: 0px; y: 0px; width: parent.width; index: root.index; }
    PageHeading {
        x: 0px; y: 29px; width: parent.width - 330px;
        eyebrow: root.eyebrow; title: root.title; subtitle: root.subtitle;
    }
    CommandButton {
        x: root.primary-label == "" ? parent.width - 90px : parent.width - root.primary-width - 100px;
        y: 61px; width: 90px;
        text: "Export"; show-icon: true; icon-name: IconName.download;
    }
    if root.primary-label != "": CommandButton {
        x: parent.width - root.primary-width; y: 61px; width: root.primary-width;
        text: root.primary-label; show-icon: true; icon-name: root.primary-icon; primary: true;
        clicked => { root.primary-clicked(); }
    }
}

// Local demonstration input: it accepts text without applying product-side filtering.
export component CommandSearchField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder-text;
    in property <string> accessible-name: root.placeholder-text;
    in property <length> right-inset: 10px;
    out property <bool> focused: editor.has-focus;
    height: 32px;
    clip: true;
    border-width: 1px;
    border-color: root.focused ? CommandTheme.accent : CommandTheme.border;
    border-radius: 5px;
    background: #ffffff;
    animate border-color { duration: 110ms; }

    AtlasIcon {
        x: 9px; y: (parent.height - 13px) / 2; size: 13px;
        name: IconName.search;
        icon-color: root.focused ? CommandTheme.accent : #8b929b;
    }
    editor := TextInput {
        x: 31px; y: 1px; width: parent.width - self.x - root.right-inset; height: parent.height - 2px;
        text <=> root.value;
        single-line: true;
        color: CommandTheme.text;
        selection-foreground-color: #ffffff;
        selection-background-color: CommandTheme.accent;
        font-family: AtlasTypography.font-sans;
        font-size: 9px;
        vertical-alignment: center;
        accessible-label: root.accessible-name;
    }
    Text {
        x: 31px; y: 1px; width: parent.width - self.x - root.right-inset; height: parent.height - 2px;
        visible: root.value == "" && !root.focused;
        text: root.placeholder-text;
        color: #8b929b;
        font-family: AtlasTypography.font-sans;
        font-size: 9px;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component CommandToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> accessible-name;
    width: 44px;
    height: 24px;
    border-width: 1px;
    border-color: root.checked ? #354add : #b9c0ca;
    border-radius: 12px;
    background: root.checked ? CommandTheme.accent : toggle-action.has-hover ? #e8ebef : #f4f5f7;
    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }
    accessible-role: AccessibleRole.switch;
    accessible-label: root.accessible-name;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; }

    knob := Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? #ffffff : #66717e;
        animate x { duration: 150ms; easing: ease-in-out; }
        animate background { duration: 120ms; }
    }
    toggle-action := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.checked = !root.checked; }
    }
}

export component FieldBox inherits Rectangle {
    in property <string> text;
    in property <IconName> icon-name: IconName.search;
    in property <bool> show-icon: true;
    in property <bool> disabled: false;
    height: 32px;
    border-width: 1px; border-color: CommandTheme.border; border-radius: 5px;
    background: root.disabled ? #f4f5f6 : #ffffff;
    if root.show-icon: AtlasIcon { x: 9px; y: (parent.height - 13px) / 2; size: 13px; name: root.icon-name; icon-color: #8b929b; }
    Text {
        x: root.show-icon ? 31px : 10px; width: parent.width - self.x - 19px;
        text: root.text; color: root.disabled ? #a1a6ad : #69707a;
        font-family: AtlasTypography.font-sans; font-size: 8px;
        horizontal-alignment: left; vertical-alignment: center; overflow: elide;
    }
}

export component MiniAction inherits Rectangle {
    in property <string> text;
    in property <IconName> icon-name: IconName.filter;
    in property <bool> show-icon: false;
    callback clicked();
    height: 32px;
    border-width: 1px; border-color: action.hovered ? #b9c0c9 : CommandTheme.border; border-radius: 5px;
    background: action.pressed ? #f0f1f3 : action.hovered ? #fafafa : #ffffff;
    animate background { duration: 110ms; }
    animate border-color { duration: 110ms; }
    if root.show-icon: AtlasIcon { x: 9px; y: (parent.height - 12px) / 2; size: 12px; name: root.icon-name; icon-color: #737b86; }
    Text {
        x: root.show-icon ? 28px : 9px; width: parent.width - self.x - 9px;
        text: root.text; color: #666d77; font-family: AtlasTypography.font-sans; font-size: 8px;
        horizontal-alignment: left; vertical-alignment: center; overflow: elide;
    }
    action := ActionArea { accessible-name: root.text; activated => { root.clicked(); } }
}

export component TrendLine inherits Rectangle {
    in property <int> variant: 0;
    in property <color> line-color: CommandTheme.accent;
    background: #00000000;
    if root.variant == 0: Path {
        width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 32;
        fill: #00000000; stroke: root.line-color; stroke-width: 1.6px;
        MoveTo { x: 0; y: 28; } LineTo { x: 10; y: 22; } LineTo { x: 20; y: 24; }
        LineTo { x: 30; y: 17; } LineTo { x: 40; y: 19; } LineTo { x: 50; y: 13; }
        LineTo { x: 62; y: 11; } LineTo { x: 72; y: 14; } LineTo { x: 83; y: 6; }
        LineTo { x: 90; y: 8; } LineTo { x: 100; y: 2; }
    }
    if root.variant == 1: Path {
        width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 32;
        fill: #00000000; stroke: root.line-color; stroke-width: 1.6px;
        MoveTo { x: 0; y: 25; } LineTo { x: 12; y: 20; } LineTo { x: 22; y: 21; }
        LineTo { x: 33; y: 12; } LineTo { x: 44; y: 17; } LineTo { x: 55; y: 8; }
        LineTo { x: 65; y: 12; } LineTo { x: 76; y: 5; } LineTo { x: 86; y: 8; }
        LineTo { x: 100; y: 2; }
    }
    if root.variant >= 2: Path {
        width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 32;
        fill: #00000000; stroke: root.line-color; stroke-width: 1.6px;
        MoveTo { x: 0; y: 3; } LineTo { x: 10; y: 8; } LineTo { x: 20; y: 7; }
        LineTo { x: 30; y: 16; } LineTo { x: 40; y: 12; } LineTo { x: 53; y: 20; }
        LineTo { x: 64; y: 25; } LineTo { x: 74; y: 22; } LineTo { x: 86; y: 27; }
        LineTo { x: 100; y: 31; }
    }
}

export component MetricTile inherits Rectangle {
    in property <MetricRecord> metric;
    AtlasMetricCard {
        width: parent.width;
        height: parent.height;
        compact: false;
        label: root.metric.label;
        value: root.metric.value;
        meta: root.metric.trend + "  " + root.metric.context;
        help-text: root.metric.context;
        tone: root.metric.style == 2 ? ValueTone.positive : ValueTone.neutral;
        background: root.metric.style == 3 ? CommandTheme.dark-surface : CommandTheme.surface;
        border-color: root.metric.style == 1 ? CommandTheme.accent
            : root.metric.style == 3 ? CommandTheme.dark-surface : CommandTheme.border;
        border-radius: 8px;
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 6px;
        background: root.metric.style == 3 ? CommandTheme.dark-surface : CommandTheme.surface;
        Text {
            x: 16px; y: 14px; width: parent.width - 32px; height: 14px;
            text: root.metric.label;
            color: root.metric.style == 3 ? #aeb4bf : #777e88;
            font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 650;
            horizontal-alignment: left;
        }
        Text {
            x: 16px; y: 36px; width: parent.width - 32px; height: 34px;
            text: root.metric.value;
            color: root.metric.style == 3 ? #ffffff : CommandTheme.text;
            font-family: AtlasTypography.font-display; font-size: 27px; font-weight: 700;
            letter-spacing: -1px; horizontal-alignment: left; vertical-alignment: center;
        }
        Text {
            x: 16px; y: 79px; width: 62px; height: 14px;
            text: root.metric.trend;
            color: root.metric.style == 2 ? CommandTheme.success : root.metric.style == 3 ? #9eacff : #5367ef;
            font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 700;
            horizontal-alignment: left;
        }
        Text {
            x: 72px; y: 80px; width: parent.width - 88px; height: 13px;
            text: root.metric.context;
            color: root.metric.style == 3 ? #737b89 : #a0a5ad;
            font-family: AtlasTypography.font-sans; font-size: 8px;
            horizontal-alignment: left;
        }
        Text {
            x: 16px; y: parent.height - 22px; width: parent.width - 32px;
            text: "0" + (root.metric.style + 1);
            color: root.metric.style == 3 ? #646b76 : #bdc1c7;
            font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600;
            horizontal-alignment: left;
        }
    }
    TrendLine {
        x: parent.width - 96px;
        y: parent.height - 55px;
        width: 78px;
        height: 27px;
        variant: root.metric.style;
        line-color: root.metric.style == 2 ? CommandTheme.success : CommandTheme.accent;
    }
}

export component CommandProgressRail inherits AtlasProgressBar {
    in property <string> progress-label: "Progress";
    in property <color> fill-color: CommandTheme.accent;
    label: root.progress-label;
    show-labels: false;
    track-height: 3px;
    track-radius: 0px;
    track-color: #eceef1;
    indicator-color: root.fill-color;
    height: 3px;
}

export component MainOperationsChart inherits Rectangle {
    in property <bool> analytics: false;
    in property <bool> alternate: false;
    background: #00000000;
    for grid-index in 5: Rectangle {
        y: grid-index * (parent.height - 22px) / 4;
        width: parent.width;
        height: 1px;
        background: #edf0f2;
    }
    for column-index in 7: Rectangle {
        x: column-index * (parent.width - 1px) / 6;
        width: 1px;
        height: parent.height - 22px;
        background: #f4f5f7;
    }
    Path {
        width: parent.width; height: parent.height - 22px;
        viewbox-width: 720; viewbox-height: 190;
        fill: #4057f41d; stroke: #00000000;
        MoveTo { x: 0; y: 190; }
        LineTo { x: 0; y: root.analytics ? 114 : root.alternate ? 137 : 152; }
        LineTo { x: 65; y: root.analytics ? 94 : root.alternate ? 130 : 135; }
        LineTo { x: 131; y: root.analytics ? 104 : root.alternate ? 113 : 121; }
        LineTo { x: 196; y: root.analytics ? 79 : root.alternate ? 107 : 132; }
        LineTo { x: 262; y: root.analytics ? 67 : root.alternate ? 116 : 108; }
        LineTo { x: 327; y: root.analytics ? 75 : root.alternate ? 88 : 83; }
        LineTo { x: 393; y: root.analytics ? 54 : root.alternate ? 76 : 91; }
        LineTo { x: 458; y: root.analytics ? 39 : root.alternate ? 83 : 60; }
        LineTo { x: 524; y: root.analytics ? 48 : root.alternate ? 63 : 70; }
        LineTo { x: 589; y: root.analytics ? 21 : root.alternate ? 47 : 43; }
        LineTo { x: 655; y: root.analytics ? 15 : root.alternate ? 54 : 51; }
        LineTo { x: 720; y: root.analytics ? 1 : root.alternate ? 35 : 22; }
        LineTo { x: 720; y: 190; }
        Close { }
    }
    Path {
        width: parent.width; height: parent.height - 22px;
        viewbox-width: 720; viewbox-height: 190;
        fill: #00000000; stroke: CommandTheme.accent; stroke-width: 2.2px;
        MoveTo { x: 0; y: root.analytics ? 114 : root.alternate ? 137 : 152; }
        LineTo { x: 65; y: root.analytics ? 94 : root.alternate ? 130 : 135; }
        LineTo { x: 131; y: root.analytics ? 104 : root.alternate ? 113 : 121; }
        LineTo { x: 196; y: root.analytics ? 79 : root.alternate ? 107 : 132; }
        LineTo { x: 262; y: root.analytics ? 67 : root.alternate ? 116 : 108; }
        LineTo { x: 327; y: root.analytics ? 75 : root.alternate ? 88 : 83; }
        LineTo { x: 393; y: root.analytics ? 54 : root.alternate ? 76 : 91; }
        LineTo { x: 458; y: root.analytics ? 39 : root.alternate ? 83 : 60; }
        LineTo { x: 524; y: root.analytics ? 48 : root.alternate ? 63 : 70; }
        LineTo { x: 589; y: root.analytics ? 21 : root.alternate ? 47 : 43; }
        LineTo { x: 655; y: root.analytics ? 15 : root.alternate ? 54 : 51; }
        LineTo { x: 720; y: root.analytics ? 1 : root.alternate ? 35 : 22; }
    }
    if !root.analytics: Path {
        width: parent.width; height: parent.height - 22px;
        viewbox-width: 720; viewbox-height: 190;
        fill: #00000000; stroke: CommandTheme.danger; stroke-width: 1.3px;
        MoveTo { x: 0; y: 179; } LineTo { x: 65; y: 176; } LineTo { x: 131; y: 174; }
        LineTo { x: 196; y: 168; } LineTo { x: 262; y: 171; } LineTo { x: 327; y: 164; }
        LineTo { x: 393; y: 160; } LineTo { x: 458; y: 162; } LineTo { x: 524; y: 153; }
        LineTo { x: 589; y: 158; } LineTo { x: 655; y: 150; } LineTo { x: 720; y: 147; }
    }
}

export component FooterMark inherits Rectangle {
    in property <bool> show-updated: true;
    height: 12px;
    Text { text: "ATLAS COMMAND / OPERATIONS CONSOLE"; color: #a3a8b0; font-family: AtlasTypography.font-sans; font-size: 7px; letter-spacing: 0.75px; }
    if root.show-updated: Text { width: parent.width; horizontal-alignment: right; text: "Updated 8 seconds ago"; color: #a3a8b0; font-family: AtlasTypography.font-sans; font-size: 7px; letter-spacing: 0.45px; }
}
