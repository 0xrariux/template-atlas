import {
    AtlasIcon, IconName, AtlasTypography, AtlasShape,
    AtlasEdgeSurface, AtlasStatusIndicator, BadgeTone, DividerEdge
} from "@atlas-ui/stable.slint";
import { ActionArea } from "@atlas-ui/preview-nonresponsive.slint";
import { CommandTheme } from "theme.slint";
import { NavItem, CommandIconButton } from "components.slint";

export component CommandSidebar inherits AtlasEdgeSurface {
    in property <int> current-page: 0;
    callback navigate(int);

    width: CommandTheme.sidebar-width;
    divider-edge: DividerEdge.right;
    divider-color: #24272c;
    background: CommandTheme.sidebar;

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 83px;
        background: #00000000;
        Rectangle { y: 82px; width: parent.width; height: 1px; background: #26292e; }
        Rectangle {
            x: 23px; y: 27px; width: 28px; height: 28px;
            background: #00000000;
            Path { x: 7px; y: 0px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14; fill: CommandTheme.accent; stroke: CommandTheme.accent; stroke-width: 1px; MoveTo { x: 7; y: 0; } LineTo { x: 14; y: 7; } LineTo { x: 7; y: 14; } LineTo { x: 0; y: 7; } Close { } }
            Path { x: 0px; y: 7px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14; fill: #00000000; stroke: #7584ff; stroke-width: 1px; MoveTo { x: 7; y: 0; } LineTo { x: 14; y: 7; } LineTo { x: 7; y: 14; } LineTo { x: 0; y: 7; } Close { } }
            Path { x: 14px; y: 7px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14; fill: #00000000; stroke: #7584ff; stroke-width: 1px; MoveTo { x: 7; y: 0; } LineTo { x: 14; y: 7; } LineTo { x: 7; y: 14; } LineTo { x: 0; y: 7; } Close { } }
            Path { x: 7px; y: 14px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14; fill: #00000000; stroke: #7584ff; stroke-width: 1px; MoveTo { x: 7; y: 0; } LineTo { x: 14; y: 7; } LineTo { x: 7; y: 14; } LineTo { x: 0; y: 7; } Close { } }
        }
        Text { x: 62px; y: 27px; width: parent.width - 74px; text: "ATLAS"; color: #ffffff; font-family: AtlasTypography.font-sans; font-size: 13px; font-weight: 700; letter-spacing: 1.7px; horizontal-alignment: left; }
        Text { x: 62px; y: 46px; width: parent.width - 74px; text: "COMMAND"; color: #777e89; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; letter-spacing: 1.15px; horizontal-alignment: left; }
    }

    Text { x: 22px; y: 106px; text: "WORKSPACE"; color: #626872; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; letter-spacing: 1.25px; }
    VerticalLayout {
        x: 12px; y: 127px; width: parent.width - 24px; spacing: 0px;
        NavItem { label: "Overview"; icon-name: IconName.grid; selected: root.current-page == 0; clicked => { root.navigate(0); } }
        NavItem { label: "Analytics"; icon-name: IconName.analytics; selected: root.current-page == 1; clicked => { root.navigate(1); } }
        NavItem { label: "Services"; icon-name: IconName.layers; selected: root.current-page == 2; clicked => { root.navigate(2); } }
        NavItem { label: "Activity"; icon-name: IconName.activity; selected: root.current-page == 3; clicked => { root.navigate(3); } }
        NavItem { label: "Alerts"; icon-name: IconName.shield; count: "3"; selected: root.current-page == 4; clicked => { root.navigate(4); } }
        NavItem { label: "Logs"; icon-name: IconName.logs; selected: root.current-page == 5; clicked => { root.navigate(5); } }
    }
    Text { x: 22px; y: 391px; text: "MANAGE"; color: #626872; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; letter-spacing: 1.25px; }
    VerticalLayout {
        x: 12px; y: 410px; width: parent.width - 24px; spacing: 0px;
        NavItem { label: "Team"; icon-name: IconName.users; selected: root.current-page == 6; clicked => { root.navigate(6); } }
        NavItem { label: "Integrations"; icon-name: IconName.webhook; selected: root.current-page == 7; clicked => { root.navigate(7); } }
        NavItem { label: "Settings"; icon-name: IconName.settings; selected: root.current-page == 8; clicked => { root.navigate(8); } }
    }

    Rectangle {
        x: 12px; y: parent.height - 71px; width: parent.width - 24px; height: 59px;
        background: #00000000; border-width: 0px;
        Rectangle { y: 0px; width: parent.width; height: 1px; background: #292c31; }
        Rectangle {
            x: 9px; y: 15px; width: 32px; height: 32px; border-radius: AtlasShape.radius-round; background: #393e48;
            Text { text: "DA"; color: #ffffff; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            AtlasStatusIndicator { x: 25px; y: 25px; width: 7px; height: 7px; label: "Administrator online"; tone: BadgeTone.healthy; indicator-color: #38a775; border-width: 2px; border-color: CommandTheme.sidebar; }
        }
        Text { x: 51px; y: 17px; text: "Demo Administrator"; color: #ffffff; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: 600; }
        Text { x: 51px; y: 34px; text: "Sample workspace"; color: #747b85; font-family: AtlasTypography.font-sans; font-size: 9px; }
        AtlasIcon { x: parent.width - 24px; y: 24px; size: 14px; name: IconName.menu; icon-color: #626872; }
    }
}

export component CommandTopbar inherits AtlasEdgeSurface {
    in property <string> page-title;
    in-out property <string> search-value;
    callback search-requested();
    callback notifications-requested();

    height: CommandTheme.topbar-height;
    divider-edge: DividerEdge.bottom;
    divider-color: CommandTheme.border;
    background: CommandTheme.topbar;

    Text { x: 27px; width: 70px; text: root.page-title; color: CommandTheme.text; font-family: AtlasTypography.font-sans; font-size: 12px; font-weight: 700; vertical-alignment: center; }
    Text { x: 89px; width: 10px; text: "/"; color: #c1c5cb; font-family: AtlasTypography.font-sans; font-size: 12px; vertical-alignment: center; }
    Text { x: 105px; text: "Production"; color: CommandTheme.muted; font-family: AtlasTypography.font-sans; font-size: 11px; vertical-alignment: center; }

    search := Rectangle {
        x: (parent.width - 340px) / 2;
        y: 14px;
        width: 340px;
        height: 35px;
        border-width: 1px;
        border-color: top-search.has-focus ? CommandTheme.accent : CommandTheme.border;
        border-radius: 6px;
        background: #f7f8f9;
        animate border-color { duration: 110ms; }
        AtlasIcon { x: 10px; y: 9px; size: 16px; name: IconName.search; icon-color: #8a909a; }
        top-search := TextInput {
            x: 36px; y: 1px; width: parent.width - 82px; height: parent.height - 2px;
            text <=> root.search-value;
            single-line: true;
            color: CommandTheme.text;
            selection-foreground-color: #ffffff;
            selection-background-color: CommandTheme.accent;
            font-family: AtlasTypography.font-sans;
            font-size: 11px;
            vertical-alignment: center;
            accessible-label: "Search Atlas Command";
        }
        Text { x: 36px; width: parent.width - 80px; visible: root.search-value == "" && !top-search.has-focus; text: "Search or run command..."; color: #8a909a; font-family: AtlasTypography.font-sans; font-size: 11px; vertical-alignment: center; }
        Rectangle { x: parent.width - 42px; y: 8px; width: 32px; height: 19px; border-width: 1px; border-color: #d9dce1; border-radius: 4px; background: #ffffff;
            Text { text: "⌘ K"; color: #7c828c; font-family: AtlasTypography.font-sans; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
            search-action := ActionArea { accessible-name: "Open command palette"; activated => { root.search-requested(); } }
        }
    }

    Rectangle {
        x: parent.width - 260px; y: 15px; width: 132px; height: 34px; background: #00000000;
        AtlasIcon { x: 7px; y: 9px; size: 16px; name: IconName.clock; icon-color: #59606b; }
        Text { x: 31px; width: 90px; text: "Aug 26 — Sep 01"; color: #59606b; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 600; vertical-alignment: center; }
        AtlasIcon { x: 120px; y: 11px; size: 12px; name: IconName.chevron-down; icon-color: #59606b; }
    }
    CommandIconButton { x: parent.width - 121px; y: 15px; icon-name: IconName.info; accessible-label: "Help"; }
    notice := CommandIconButton { x: parent.width - 80px; y: 15px; icon-name: IconName.bell; accessible-label: "Notifications"; clicked => { root.notifications-requested(); } }
    AtlasStatusIndicator { x: parent.width - 70px; y: 21px; width: 5px; height: 5px; label: "Unread notifications"; tone: BadgeTone.live; indicator-color: #5165ef; border-width: 1px; border-color: #ffffff; }
    Rectangle { x: parent.width - 44px; y: 17px; width: 29px; height: 29px; border-radius: AtlasShape.radius-round; background: #20232a;
        Text { text: "DA"; color: #ffffff; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}
