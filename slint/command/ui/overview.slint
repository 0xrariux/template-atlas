import { AtlasIcon, IconName, AtlasTypography, AtlasShape } from "@atlas-ui/stable.slint";
import { ActionArea, AtlasRadialProgress, ProgressTone } from "@atlas-ui/preview-nonresponsive.slint";
import { CommandTheme } from "theme.slint";
import {
    MetricRecord, ServiceRecord, HealthRecord, ActivityRecord, AlertRecord
} from "models.slint";
import {
    CommandSurface, CommandButton, CommandBadge, PageRule, PageHeading,
    SectionTitle, MetricTile, MainOperationsChart, FooterMark
} from "components.slint";

component PeriodButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();
    height: 26px;
    min-width: 32px;
    border-radius: 4px;
    background: root.selected ? #ffffff : action.hovered ? #e9ebee : #00000000;
    Text { text: root.text; color: root.selected ? #202329 : #858b95; font-family: AtlasTypography.font-sans; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    action := ActionArea { accessible-name: root.text; selected: root.selected; activated => { root.clicked(); } }
}

export component OverviewPage inherits Rectangle {
    in property <[MetricRecord]> metrics;
    in property <[ServiceRecord]> services;
    in property <[HealthRecord]> health-services;
    in property <[ActivityRecord]> activities;
    in property <[AlertRecord]> alerts;
    in-out property <int> period: 2;
    in-out property <int> selected-service: -1;
    in-out property <int> row-menu: -1;
    callback create-report-requested();

    height: 1395px;
    background: #00000000;

    PageRule { x: 0px; y: 0px; width: parent.width; index: "01"; }
    PageHeading {
        x: 0px; y: 29px; width: parent.width - 390px;
        eyebrow: "SYSTEM WIDE STATUS";
        title: "Operations Overview";
        subtitle: "Real-time visibility across your infrastructure and services.";
        operational: true;
    }
    HorizontalLayout {
        x: parent.width - 317px; y: 63px; width: 317px; height: 35px; spacing: 8px;
        CommandButton { text: "Export"; show-icon: true; icon-name: IconName.download; }
        CommandButton { text: "Customize"; show-icon: true; icon-name: IconName.filter; }
        CommandButton { text: "Create Report"; show-icon: true; icon-name: IconName.add; primary: true; clicked => { root.create-report-requested(); } }
    }

    HorizontalLayout {
        y: 123px; width: parent.width; height: 146px; spacing: 12px;
        for metric in root.metrics: MetricTile { horizontal-stretch: 1; metric: metric; }
    }

    activity-card := CommandSurface {
        x: 0px;
        y: 282px;
        width: (parent.width - 12px) * 0.695;
        height: 397px;
        SectionTitle { x: 20px; y: 19px; index: "01"; title: "Platform Activity"; subtitle: "Request volume across all production services."; }
        Rectangle {
            x: parent.width - 177px; y: 18px; width: 157px; height: 30px; border-radius: 5px; background: #f2f3f5;
            HorizontalLayout { padding: 2px; spacing: 0px;
                PeriodButton { horizontal-stretch: 1; text: "1H"; selected: root.period == 0; clicked => { root.period = 0; } }
                PeriodButton { horizontal-stretch: 1; text: "6H"; selected: root.period == 1; clicked => { root.period = 1; } }
                PeriodButton { horizontal-stretch: 1; text: "24H"; selected: root.period == 2; clicked => { root.period = 2; } }
                PeriodButton { horizontal-stretch: 1; text: "7D"; selected: root.period == 3; clicked => { root.period = 3; } }
                PeriodButton { horizontal-stretch: 1; text: "30D"; selected: root.period == 4; clicked => { root.period = 4; } }
            }
        }
        Rectangle { x: 60px; y: 82px; width: 11px; height: 2px; background: CommandTheme.accent; }
        Text { x: 78px; y: 76px; text: "Successful Requests"; color: CommandTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 8px; }
        Text { x: 157px; y: 76px; text: "2.48M"; color: #343942; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; }
        Rectangle { x: 210px; y: 82px; width: 11px; height: 2px; background: CommandTheme.danger; }
        Text { x: 228px; y: 76px; text: "Failed Requests"; color: CommandTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 8px; }
        Text { x: 296px; y: 76px; text: "4,462"; color: #343942; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; }
        Text { x: 0px; y: 76px; width: parent.width - 20px; horizontal-alignment: right; text: "+11.8% vs previous"; color: #338765; font-family: AtlasTypography.font-sans; font-size: 8px; font-weight: 600; }

        Rectangle {
            x: 15px; y: 104px; width: 36px; height: 198px;
            for label[index] in ["80K", "60K", "40K", "20K", "0"]: Text {
                y: index * (parent.height - 11px) / 4; width: parent.width; height: 11px;
                text: label; color: #9298a1; font-family: AtlasTypography.font-sans; font-size: 7px;
                horizontal-alignment: right; vertical-alignment: center;
            }
        }
        MainOperationsChart { x: 60px; y: 109px; width: parent.width - 80px; height: 214px; alternate: root.period == 3; }
        HorizontalLayout {
            x: 60px; y: 326px; width: parent.width - 80px; height: 12px;
            Text { text: "00:00"; color: #a5aab2; font-family: AtlasTypography.font-sans; font-size: 7px; }
            Text { text: "04:00"; color: #a5aab2; font-family: AtlasTypography.font-sans; font-size: 7px; horizontal-alignment: center; }
            Text { text: "08:00"; color: #a5aab2; font-family: AtlasTypography.font-sans; font-size: 7px; horizontal-alignment: center; }
            Text { text: "12:00"; color: #a5aab2; font-family: AtlasTypography.font-sans; font-size: 7px; horizontal-alignment: center; }
            Text { text: "16:00"; color: #a5aab2; font-family: AtlasTypography.font-sans; font-size: 7px; horizontal-alignment: center; }
            Text { text: "20:00"; color: #a5aab2; font-family: AtlasTypography.font-sans; font-size: 7px; horizontal-alignment: center; }
            Text { text: "NOW"; color: CommandTheme.accent; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; horizontal-alignment: right; }
        }
    }

    health-card := CommandSurface {
        x: activity-card.width + 12px; y: 282px;
        width: parent.width - self.x; height: 397px;
        SectionTitle { x: 19px; y: 19px; index: "02"; title: "System Health"; subtitle: ""; }
        AtlasIcon { x: parent.width - 34px; y: 20px; size: 16px; name: IconName.menu; icon-color: CommandTheme.muted; }
        Rectangle {
            x: 19px; y: 65px; width: parent.width - 38px; height: 92px;
            border-width: 1px; border-color: #e6ebe8; border-radius: 6px; background: #f6f8f7;
            AtlasRadialProgress { x: 18px; y: 17px; width: 58px; height: 58px; value: 94; maximum: 100; meta: "94"; label: ""; tone: ProgressTone.success; }
            Text { x: 94px; y: 25px; width: parent.width - 112px; height: 18px; text: "All core systems stable"; color: CommandTheme.text; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            Text { x: 94px; y: 49px; width: parent.width - 112px; height: 15px; text: "1 service requires attention"; color: CommandTheme.muted; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
        }
        VerticalLayout {
            x: 19px; y: 168px; width: parent.width - 38px; height: parent.height - 181px; spacing: 0px;
            for service in root.health-services: Rectangle {
                height: 34px; background: #00000000;
                Rectangle { y: 0px; width: parent.width; height: 1px; background: #eef0f2; }
                CommandBadge { x: 0px; y: (parent.height - self.height) / 2; text: service.name; status-tone: service.tone; }
                Text { x: parent.width - 116px; y: 0px; width: 48px; height: parent.height; text: service.latency; color: #666d77; font-family: AtlasTypography.font-sans; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle { x: parent.width - 58px; y: (parent.height - self.height) / 2; width: 58px; height: 18px; border-radius: 3px; background: service.tone == 1 ? #fff5e4 : #edf8f3;
                    Text { text: service.status; color: service.tone == 1 ? #a06a1c : #287957; font-family: AtlasTypography.font-sans; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }

    timeline-card := CommandSurface {
        x: 0px; y: 692px; width: (parent.width - 12px) / 2; height: 250px;
        SectionTitle { x: 19px; y: 18px; index: "03"; title: "Recent Activity"; subtitle: ""; }
        Text { x: parent.width - 94px; y: 21px; text: "View activity  ›"; color: CommandTheme.accent; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 600; }
        VerticalLayout {
            x: 19px; y: 62px; width: parent.width - 38px; height: 180px; spacing: 0px;
            for activity[index] in root.activities: Rectangle {
                visible: index < 4; height: index < 4 ? 45px : 0px; background: activity-action.has-hover ? #f8f9ff : #00000000;
                animate background { duration: 100ms; }
                if index < 3: Rectangle { x: 12px; y: 25px; width: 1px; height: 20px; background: #dfe2e6; }
                Rectangle { x: 0px; y: 0px; width: 25px; height: 25px; border-width: 1px; border-color: CommandTheme.border; border-radius: AtlasShape.radius-round; background: #ffffff;
                    AtlasIcon { x: 6px; y: 6px; size: 13px; name: activity.icon == 0 ? IconName.cloud : activity.icon == 1 ? IconName.users : activity.icon == 2 ? IconName.lock : IconName.database; icon-color: #68707b; }
                }
                Text { x: 35px; y: 1px; text: activity.title; color: CommandTheme.text; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; }
                Text { x: 35px; y: 18px; width: parent.width - 90px; text: activity.detail + " · " + activity.actor; color: CommandTheme.muted; font-family: AtlasTypography.font-sans; font-size: 8px; overflow: elide; }
                Text { width: parent.width; y: 1px; horizontal-alignment: right; text: index == 0 ? "2 min" : index == 1 ? "18 min" : index == 2 ? "43 min" : "1 hr"; color: CommandTheme.muted; font-family: AtlasTypography.font-sans; font-size: 8px; }
                activity-action := TouchArea { mouse-cursor: MouseCursor.pointer; }
            }
        }
    }

    alerts-card := CommandSurface {
        x: timeline-card.width + 12px; y: 692px; width: parent.width - self.x; height: 250px;
        SectionTitle { x: 19px; y: 18px; index: "04"; title: "Alert Summary"; subtitle: ""; }
        Text { x: parent.width - 143px; y: 21px; text: "1 Critical    2 Warning    8 Info"; color: CommandTheme.muted; font-family: AtlasTypography.font-sans; font-size: 7px; }
        VerticalLayout {
            x: 19px; y: 62px; width: parent.width - 38px; height: 174px; spacing: 0px;
            for alert[index] in root.alerts: Rectangle {
                visible: index < 3; height: index < 3 ? 53px : 0px; background: alert-action.has-hover ? #fffafa : #00000000;
                animate background { duration: 100ms; }
                if index < 2: Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #edf0f2; }
                Rectangle { x: 0px; y: 13px; width: 27px; height: 27px; border-radius: 5px; background: alert.tone == 0 ? #fff0f0 : alert.tone == 1 ? #fff6e8 : #eff2f5;
                    AtlasIcon { x: 7px; y: 7px; size: 13px; name: IconName.warning; icon-color: alert.tone == 0 ? CommandTheme.danger : alert.tone == 1 ? CommandTheme.warning : #6f7782; }
                }
                Text { x: 37px; y: 9px; text: alert.title; color: CommandTheme.text; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; }
                Text { x: 37px; y: 27px; text: alert.service + " · " + alert.region; color: CommandTheme.muted; font-family: AtlasTypography.font-sans; font-size: 8px; }
                Text { x: parent.width - 70px; y: 9px; width: 30px; horizontal-alignment: right; text: index == 0 ? "4m" : index == 1 ? "12m" : "28m"; color: CommandTheme.muted; font-family: AtlasTypography.font-sans; font-size: 8px; }
                Rectangle { x: parent.width - 28px; y: 14px; width: 25px; height: 25px; border-width: 1px; border-color: CommandTheme.border; border-radius: 4px; background: #ffffff;
                    AtlasIcon { x: 6px; y: 6px; size: 13px; name: IconName.check; icon-color: #79808a; }
                }
                alert-action := TouchArea { mouse-cursor: MouseCursor.pointer; }
            }
        }
    }

    services-card := CommandSurface {
        x: 0px; y: 955px; width: parent.width; height: 393px;
        SectionTitle { x: 19px; y: 18px; index: "05"; title: "Services"; subtitle: "6 production services"; }
        CommandButton { x: parent.width - 84px; y: 20px; width: 65px; text: "Filter"; show-icon: true; icon-name: IconName.filter; }
        Rectangle { x: 1px; y: 81px; width: parent.width - 2px; height: 34px; background: #f8f9fa;
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: CommandTheme.border; }
            Text { x: 45px; width: 185px; height: parent.height; text: "SERVICE"; color: #7c838e; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; vertical-alignment: center; }
            Text { x: 250px; width: 120px; height: parent.height; text: "STATUS"; color: #7c838e; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; vertical-alignment: center; }
            Text { x: 390px; width: 120px; height: parent.height; text: "REGION"; color: #7c838e; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; vertical-alignment: center; }
            Text { x: 540px; width: 110px; height: parent.height; text: "REQUESTS"; color: #7c838e; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; vertical-alignment: center; }
            Text { x: 680px; width: 100px; height: parent.height; text: "LATENCY"; color: #7c838e; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; vertical-alignment: center; }
            Text { x: 810px; width: 90px; height: parent.height; text: "ERRORS"; color: #7c838e; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; vertical-alignment: center; }
            Text { x: 930px; height: parent.height; text: "VERSION"; color: #7c838e; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; vertical-alignment: center; }
        }
        VerticalLayout {
            x: 1px; y: 115px; width: parent.width - 2px; height: parent.height - 116px; spacing: 0px;
            for service[index] in root.services: Rectangle {
                height: 46px;
                background: root.selected-service == index ? #f7f8ff : row-action.hovered ? #fafbff : #ffffff;
                if index < root.services.length - 1: Rectangle { y: 45px; width: parent.width; height: 1px; background: #edf0f2; }
                Rectangle { x: 10px; y: 15px; width: 14px; height: 14px; border-width: 1px; border-color: root.selected-service == index ? CommandTheme.accent : #cfd4da; border-radius: 3px; background: root.selected-service == index ? CommandTheme.accent : #ffffff;
                    if root.selected-service == index: AtlasIcon { x: 2px; y: 2px; size: 10px; name: IconName.check; icon-color: #ffffff; }
                }
                Rectangle { x: 45px; y: 10px; width: 25px; height: 25px; border-width: 1px; border-color: #dfe3e8; border-radius: 5px; background: #f7f8fa;
                    Text { text: service.initials; color: #6d7480; font-family: AtlasTypography.font-sans; font-size: 7px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { x: 80px; y: 0px; width: 150px; height: parent.height; text: service.name; color: #252930; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                CommandBadge { x: 250px; y: 12px; text: service.status; status-tone: service.tone; }
                Text { x: 390px; y: 0px; width: 120px; height: parent.height; text: service.region; color: #7d838d; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
                Text { x: 540px; y: 0px; width: 110px; height: parent.height; text: service.requests; color: #464c55; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
                Text { x: 680px; y: 0px; width: 100px; height: parent.height; text: service.latency; color: #464c55; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
                Text { x: 810px; y: 0px; width: 90px; height: parent.height; text: service.errors; color: service.tone == 1 ? CommandTheme.danger : #464c55; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
                Text { x: 930px; y: 0px; width: 90px; height: parent.height; text: service.version; color: #777e88; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                AtlasIcon { x: parent.width - 30px; y: 16px; size: 14px; name: IconName.menu; icon-color: #828892; }
                row-action := ActionArea { accessible-name: service.name; activated => { root.selected-service = root.selected-service == index ? -1 : index; root.row-menu = index; } }
            }
        }
        if root.row-menu >= 0: Rectangle {
            x: parent.width - 158px; y: 151px + root.row-menu * 46px; width: 128px; height: 95px;
            border-width: 1px; border-color: CommandTheme.border; border-radius: 6px; background: #ffffff;
            drop-shadow-color: #14192024; drop-shadow-blur: 20px; drop-shadow-offset-y: 7px;
            VerticalLayout { x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 4px;
                Text { text: "View details"; color: #4d535c; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
                Text { text: "View logs"; color: #4d535c; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
                Text { text: "Configure"; color: #4d535c; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
            }
        }
    }
    FooterMark { y: 1375px; width: parent.width; }
}
