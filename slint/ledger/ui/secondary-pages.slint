import { AtlasIcon, IconName, AtlasTypography } from "@atlas-ui/stable.slint";
import { ActionArea } from "@atlas-ui/preview-nonresponsive.slint";
import { LedgerTheme } from "theme.slint";
import { AssetRecord } from "models.slint";
import { LedgerSurface, LedgerButton, SectionLabel, PageHeading, SummaryCell, LedgerSearchField, AssetMark, LedgerMeter, LedgerTabs, LedgerChart } from "components.slint";

component AssetRegisterRow inherits Rectangle {
    in property <AssetRecord> asset;
    in property <bool> selected;
    callback clicked();
    height: 66px;
    background: root.selected ? #edf1ed : action.hovered ? #f3f1eb : LedgerTheme.surface;
    if root.selected: Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: LedgerTheme.green; }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border-soft; }
    AssetMark { x: 12px; y: 15px; symbol: root.asset.symbol == "ETH" ? "E" : root.asset.symbol == "BTC" ? "B" : root.asset.symbol == "USDC" ? "U" : root.asset.symbol == "SOL" ? "S" : "L"; tone: root.asset.tone; }
    Text { x: 51px; y: 9px; width: parent.width * 0.10; height: 19px; text: root.asset.symbol; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    Text { x: 51px; y: 29px; width: parent.width * 0.10; height: 16px; text: root.asset.name; color: LedgerTheme.muted; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
    Text { x: parent.width * 0.21; y: 10px; width: parent.width * 0.11; height: 19px; text: root.asset.balance; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 600; vertical-alignment: center; }
    Text { x: parent.width * 0.21; y: 29px; width: parent.width * 0.11; height: 16px; text: root.asset.symbol; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
    Text { x: parent.width * 0.34; width: parent.width * 0.11; text: root.asset.price; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
    Text { x: parent.width * 0.46; width: parent.width * 0.12; text: root.asset.value; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 650; vertical-alignment: center; }
    Text { x: parent.width * 0.59; width: parent.width * 0.08; text: root.asset.change; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
    Text { x: parent.width * 0.68; y: 10px; width: parent.width * 0.09; height: 17px; text: root.asset.allocation; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
    LedgerMeter { x: parent.width * 0.68; y: 35px; width: parent.width * 0.08; value: root.asset.allocation-value / 10; }
    Text { x: parent.width * 0.79; width: parent.width * 0.16; text: "•  " + root.asset.network; color: LedgerTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
    AtlasIcon { x: parent.width - 20px; y: 25px; size: 9px; name: IconName.chevron-right; icon-color: LedgerTheme.muted; }
    action := ActionArea { selected: root.selected; accessible-name: root.asset.symbol; activated => { root.clicked(); } }
}

export component AssetsPage inherits Rectangle {
    in property <[AssetRecord]> assets;
    in property <string> capture-state;
    in-out property <int> selected-index: root.capture-state == "assets-btc" ? 1 : 0;
    Rectangle { x: 27px; y: 30px; width: parent.width - 54px; height: 1120px;
        PageHeading { x: 0px; y: 0px; width: parent.width; eyebrow: "02 / ASSET REGISTER"; title: "Assets"; subtitle: "Detailed balances, valuation, allocation, and network exposure."; }
        LedgerButton { x: parent.width - 244px; y: 10px; width: 119px; text: "Export Holdings"; show-icon: true; icon-name: IconName.download; }
        LedgerButton { x: parent.width - 116px; y: 10px; width: 116px; text: "Add Asset"; show-icon: true; icon-name: IconName.add; accent: true; }
        LedgerSurface { x: 0px; y: 129px; width: parent.width; height: 104px;
            HorizontalLayout { width: parent.width; height: parent.height; spacing: 1px;
                SummaryCell { label: "TOTAL ASSET VALUE"; value: "$1,248,225"; detail: "96.2% of consolidated NAV"; }
                SummaryCell { label: "SUPPORTED ASSETS"; value: "5"; detail: "Across 3 networks"; }
                SummaryCell { label: "24H ASSET P&L"; value: "+$23,866"; detail: "+1.91% weighted return"; positive: true; }
                SummaryCell { label: "AVAILABLE LIQUIDITY"; value: "$842,180"; detail: "65.6% immediately available"; }
            }
        }
        LedgerSurface { x: 0px; y: 244px; width: parent.width; height: 84px;
            SectionLabel { x: 14px; y: 9px; width: 170px; text: "PORTFOLIO ALLOCATION"; }
            Text { x: parent.width - 85px; y: 6px; width: 70px; height: 20px; text: "100.0%"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 10px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
            Rectangle { x: 14px; y: 32px; width: parent.width - 28px; height: 7px; background: #d7d2c8;
                Rectangle { x: 0px; width: parent.width * 0.328; height: parent.height; background: #205c4d; }
                Rectangle { x: parent.width * 0.328; width: parent.width * 0.241; height: parent.height; background: #557a68; }
                Rectangle { x: parent.width * 0.569; width: parent.width * 0.187; height: parent.height; background: #829b89; }
                Rectangle { x: parent.width * 0.756; width: parent.width * 0.142; height: parent.height; background: #b6924b; }
                Rectangle { x: parent.width * 0.898; width: parent.width * 0.064; height: parent.height; background: #c5ad79; }
            }
            for asset[index] in root.assets: Rectangle { x: 14px + index * (parent.width - 28px) / 6; y: 51px; width: (parent.width - 28px) / 6; height: 20px;
                Rectangle { x: 0px; y: 7px; width: 6px; height: 6px; border-radius: 999px; background: asset.tone == 0 ? #205c4d : asset.tone == 1 ? #557a68 : asset.tone == 2 ? #829b89 : asset.tone == 3 ? #b6924b : #c5ad79; }
                Text { x: 12px; width: parent.width - 12px; text: asset.symbol + "  " + asset.allocation; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
            }
        }
        Rectangle { x: 0px; y: 339px; width: parent.width; height: 55px; border-width: 1px; border-color: LedgerTheme.border; background: LedgerTheme.surface;
            LedgerSearchField { x: 8px; y: 8px; width: parent.width - 420px; placeholder-text: "Search asset or symbol..."; accessible-name: "Search asset register"; }
            LedgerButton { x: parent.width - 403px; y: 8px; width: 125px; text: "All Networks  ⌄"; }
            LedgerButton { x: parent.width - 269px; y: 8px; width: 111px; text: "Asset Type"; show-icon: true; icon-name: IconName.filter; }
            LedgerButton { x: parent.width - 149px; y: 8px; width: 38px; text: "≡"; }
        }
        Rectangle { x: 0px; y: 405px; width: parent.width; height: 430px;
            LedgerSurface { x: 0px; width: parent.width - 341px; height: parent.height; clip: true;
                Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 35px; background: #efede7;
                    Text { x: 12px; width: parent.width * 0.18; text: "ASSET"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    Text { x: parent.width * 0.21; width: parent.width * 0.11; text: "BALANCE"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    Text { x: parent.width * 0.34; width: parent.width * 0.11; text: "PRICE"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    Text { x: parent.width * 0.46; width: parent.width * 0.12; text: "VALUE"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    Text { x: parent.width * 0.59; width: parent.width * 0.08; text: "24H"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    Text { x: parent.width * 0.68; width: parent.width * 0.10; text: "ALLOCATION"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    Text { x: parent.width * 0.79; width: parent.width * 0.16; text: "NETWORK"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                }
                for asset[index] in root.assets: AssetRegisterRow { x: 1px; y: 36px + index * 66px; width: parent.width - 2px; asset: asset; selected: root.selected-index == index; clicked => { root.selected-index = index; } }
                Rectangle { x: 1px; y: 366px; width: parent.width - 2px; height: parent.height - 367px; background: #f5f3ed;
                    SectionLabel { x: 12px; width: 220px; text: "5 ASSETS · VALUES UPDATED JUST NOW"; }
                    Text { x: parent.width - 154px; width: 142px; text: "View hidden balances  ◉"; color: LedgerTheme.green; font-family: AtlasTypography.font-sans; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            LedgerSurface { x: parent.width - 330px; width: 330px; height: parent.height;
                AssetMark { x: 17px; y: 17px; width: 42px; height: 42px; symbol: root.assets[root.selected-index].symbol == "ETH" ? "E" : root.assets[root.selected-index].symbol == "BTC" ? "B" : root.assets[root.selected-index].symbol; tone: root.assets[root.selected-index].tone; }
                SectionLabel { x: 72px; y: 14px; width: 180px; text: "SELECTED ASSET"; }
                Text { x: 72px; y: 29px; width: 200px; height: 22px; text: root.assets[root.selected-index].name; color: LedgerTheme.text; font-family: "Georgia"; font-size: 16px; vertical-alignment: center; }
                Text { x: 72px; y: 50px; width: 180px; height: 16px; text: root.assets[root.selected-index].symbol + " · " + root.assets[root.selected-index].network; color: LedgerTheme.muted; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
                SectionLabel { x: 17px; y: 88px; width: 180px; text: "CURRENT HOLDING"; }
                Text { x: 17px; y: 104px; width: parent.width - 34px; height: 32px; text: root.assets[root.selected-index].value; color: LedgerTheme.text; font-family: "Georgia"; font-size: 24px; vertical-alignment: center; }
                Text { x: 17px; y: 137px; width: 170px; height: 17px; text: root.assets[root.selected-index].balance + " " + root.assets[root.selected-index].symbol; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
                Text { x: parent.width - 117px; y: 137px; width: 100px; height: 17px; text: root.assets[root.selected-index].change + " today"; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle { x: 17px; y: 171px; width: parent.width - 34px; height: 116px; border-width: 1px; border-color: LedgerTheme.border-soft;
                    SectionLabel { x: 9px; y: 7px; width: 120px; text: "30-DAY PRICE"; }
                    LedgerTabs { x: parent.width - 113px; y: 7px; width: 104px; height: 22px; labels: ["1D", "1M", "1Y"]; selected-index: 1; }
                    LedgerChart { x: 9px; y: 38px; width: parent.width - 18px; height: 61px; alternate: root.selected-index == 1; }
                }
                Rectangle { x: 17px; y: 304px; width: parent.width - 34px; height: 91px;
                    SectionLabel { x: 0px; y: 0px; width: 130px; text: "MARKET PRICE"; }
                    Text { x: parent.width - 110px; y: -3px; width: 110px; height: 20px; text: root.assets[root.selected-index].price; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                    SectionLabel { x: 0px; y: 26px; width: 130px; text: "PORTFOLIO SHARE"; }
                    Text { x: parent.width - 110px; y: 23px; width: 110px; height: 20px; text: root.assets[root.selected-index].allocation; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                    SectionLabel { x: 0px; y: 52px; width: 130px; text: "UNREALIZED P&L"; }
                    Text { x: parent.width - 110px; y: 49px; width: 110px; height: 20px; text: "+$70,914"; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
        }
    }
}

export component AnalyticsPage inherits Rectangle {
    Rectangle { x: 27px; y: 30px; width: parent.width - 54px; height: 1120px;
        PageHeading { x: 0px; y: 0px; width: parent.width; eyebrow: "06 / TREASURY INTELLIGENCE"; title: "Analytics"; subtitle: "Performance attribution, cash movement, and portfolio risk."; }
        LedgerButton { x: parent.width - 244px; y: 10px; width: 119px; text: "Export Report"; show-icon: true; icon-name: IconName.download; }
        LedgerButton { x: parent.width - 116px; y: 10px; width: 116px; text: "Create Analysis"; show-icon: true; icon-name: IconName.add; accent: true; }
        LedgerSurface { x: 0px; y: 129px; width: parent.width; height: 104px;
            HorizontalLayout { width: parent.width; height: parent.height; spacing: 1px;
                SummaryCell { label: "NET PERFORMANCE"; value: "+$24,812"; detail: "+1.97% this month"; positive: true; }
                SummaryCell { label: "NET INFLOWS"; value: "+$42,180"; detail: "Deposits less withdrawals"; }
                SummaryCell { label: "REALIZED P&L"; value: "+$8,420"; detail: "12 closed positions"; positive: true; }
                SummaryCell { label: "UNREALIZED P&L"; value: "+$16,392"; detail: "Across 5 holdings"; positive: true; }
                SummaryCell { label: "FEES"; value: "−$1,128"; detail: "0.09% of NAV"; }
            }
        }
        Rectangle { x: 0px; y: 244px; width: parent.width; height: 414px;
            LedgerSurface { x: 0px; width: parent.width - 329px; height: parent.height;
                SectionLabel { x: 16px; y: 13px; width: 180px; text: "PORTFOLIO PERFORMANCE"; }
                Text { x: 16px; y: 30px; width: 200px; height: 22px; text: "Net return over time"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 16px; vertical-alignment: center; }
                LedgerTabs { x: parent.width - 306px; y: 15px; width: 154px; labels: ["Performance", "Benchmark"]; selected-index: 0; }
                LedgerTabs { x: parent.width - 143px; y: 15px; width: 127px; labels: ["1W", "1M", "3M", "1Y"]; selected-index: 1; }
                Text { x: 16px; y: 70px; width: 150px; height: 35px; text: "+1.97%"; color: LedgerTheme.positive; font-family: "Georgia"; font-size: 26px; vertical-alignment: center; }
                Text { x: 130px; y: 77px; width: 180px; height: 20px; text: "vs benchmark  +0.42%"; color: LedgerTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 10px; vertical-alignment: center; }
                for label[index] in ["+3.0%", "+2.0%", "+1.0%", "0.0%", "−1.0%"]: Text {
                    x: 12px; y: 117px + index * 55px; width: 47px; height: 16px;
                    text: label; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px;
                    horizontal-alignment: right; vertical-alignment: center;
                }
                LedgerChart { x: 70px; y: 125px; width: parent.width - 86px; height: 221px; grid-lines: 5; }
                for label[index] in ["AUG 01", "AUG 08", "AUG 15", "AUG 22", "SEP 01"]: Text {
                    x: 70px + index * (parent.width - 134px) / 4; y: 349px; width: 48px; height: 20px;
                    text: label; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px;
                    horizontal-alignment: index == 0 ? left : index == 4 ? right : center;
                    vertical-alignment: center;
                }
            }
            LedgerSurface { x: parent.width - 318px; width: 318px; height: parent.height;
                SectionLabel { x: 16px; y: 13px; width: parent.width - 32px; text: "RETURN ATTRIBUTION"; }
                Text { x: 16px; y: 30px; width: parent.width - 32px; height: 22px; text: "Contributors"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 16px; vertical-alignment: center; }
                for name[index] in ["ETH", "BTC", "LINK", "SOL", "Fees"]: Rectangle { x: 16px; y: 70px + index * 48px; width: parent.width - 32px; height: 39px;
                    Rectangle { x: 0px; y: 7px; width: 6px; height: 6px; border-radius: 999px; background: index == 4 ? LedgerTheme.negative : LedgerTheme.green; }
                    Text { x: 13px; y: 0px; width: 50px; height: 18px; text: name; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 650; vertical-alignment: center; }
                    Text { x: 76px; y: 0px; width: 80px; height: 18px; text: index == 0 ? "+$14,284" : index == 1 ? "+$7,892" : index == 2 ? "+$1,204" : index == 3 ? "+$486" : "−$1,128"; color: index == 4 ? LedgerTheme.negative : LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
                    Text { x: parent.width - 62px; y: 0px; width: 62px; height: 18px; text: index == 0 ? "+1.12%" : index == 1 ? "+0.62%" : index == 2 ? "+0.09%" : index == 3 ? "+0.04%" : "−0.09%"; color: index == 4 ? LedgerTheme.negative : LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                    LedgerMeter { x: 13px; y: 27px; width: parent.width - 13px; value: index == 0 ? 58 : index == 1 ? 32 : index == 2 ? 12 : index == 3 ? 6 : 5; meter-color: index == 4 ? LedgerTheme.negative : LedgerTheme.green; }
                }
                Rectangle { x: 16px; y: parent.height - 61px; width: parent.width - 32px; height: 45px; border-width: 1px; border-color: LedgerTheme.border-soft; background: #f5f3ed;
                    SectionLabel { x: 9px; width: 160px; text: "TOTAL ATTRIBUTED RETURN"; }
                    Text { x: parent.width - 93px; width: 82px; text: "+$22,738"; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 10px; font-weight: 650; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
        }
        LedgerSurface { x: 0px; y: 669px; width: parent.width * 0.64; height: 280px;
            SectionLabel { x: 16px; y: 14px; width: 180px; text: "CASH FLOW ANALYSIS"; }
            Text { x: 16px; y: 31px; width: 240px; height: 22px; text: "Net asset value bridge"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 16px; vertical-alignment: center; }
            for label[index] in ["Opening NAV", "Deposits", "Withdrawals", "Market P&L", "Fees", "Closing NAV"]: Rectangle { x: 25px + index * (parent.width - 50px) / 6; y: 73px; width: (parent.width - 50px) / 6; height: 176px;
                Rectangle { x: 17px; y: index == 0 || index == 5 ? 24px : index == 1 ? 47px : index == 2 ? 91px : index == 3 ? 70px : 108px; width: parent.width - 34px; height: index == 0 || index == 5 ? 105px : index == 1 ? 82px : index == 2 ? 42px : index == 3 ? 59px : 21px; background: index == 2 || index == 4 ? #b96d67 : index == 0 || index == 5 ? #557a68 : #6f9e8c; }
                Text { y: 133px; width: parent.width; height: 19px; text: index == 0 ? "$1.241M" : index == 1 ? "+$84.2K" : index == 2 ? "−$42.0K" : index == 3 ? "+$24.8K" : index == 4 ? "−$1.1K" : "$1.284M"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 8px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                Text { y: 153px; width: parent.width; height: 18px; text: label; color: LedgerTheme.muted; font-family: AtlasTypography.font-sans; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}
