import { AtlasIcon, IconName, AtlasTypography } from "@atlas-ui/stable.slint";
import { ActionArea, AtlasModalFrame, AtlasDrawerFrame, AtlasCopyableValue, DrawerSide } from "@atlas-ui/preview-nonresponsive.slint";
import { LedgerTheme } from "theme.slint";
import { TransactionRecord } from "models.slint";
import { LedgerButton, SectionLabel, LedgerStatus, ToolField } from "components.slint";

export component NotificationsPanel inherits Rectangle {
    in-out property <bool> open: false;
    callback dismissed();
    visible: root.open;
    width: 350px; height: 246px;
    border-width: 1px; border-color: LedgerTheme.border; border-radius: 3px;
    background: LedgerTheme.surface;
    drop-shadow-color: #00000033; drop-shadow-blur: 24px; drop-shadow-offset-y: 9px;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 65px;
        SectionLabel { x: 16px; y: 11px; width: 250px; text: "DEMO NOTIFICATIONS"; }
        Text { x: 16px; y: 28px; width: 260px; height: 23px; text: "Treasury updates"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 16px; vertical-alignment: center; }
        AtlasIcon { x: parent.width - 31px; y: 22px; size: 12px; name: IconName.close; icon-color: LedgerTheme.muted; }
        close := ActionArea { x: parent.width - 44px; y: 10px; width: 40px; height: 40px; accessible-name: "Close notifications"; activated => { root.open = false; root.dismissed(); } }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border; }
    }
    for title[index] in ["Sample transfer confirmed", "Demo threshold reached", "Sample reconciliation complete"]: Rectangle { x: 0px; y: 65px + index * 60px; width: parent.width; height: 60px;
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border-soft; }
        Rectangle { x: 15px; y: 14px; width: 30px; height: 30px; border-radius: 999px; background: index == 1 ? #f1eadb : #e4efeb;
            AtlasIcon { x: 9px; y: 9px; size: 12px; name: index == 1 ? IconName.analytics : index == 2 ? IconName.shield : IconName.check; icon-color: index == 1 ? LedgerTheme.gold : LedgerTheme.positive; }
        }
        Text { x: 57px; y: 8px; width: 225px; height: 20px; text: title; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 650; vertical-alignment: center; }
        Text { x: 57px; y: 28px; width: 225px; height: 17px; text: index == 0 ? "24,000 USDC · simulated" : index == 1 ? "Sample NAV exceeded $1.28M" : "All demo accounts balanced"; color: LedgerTheme.muted; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
        Text { x: parent.width - 38px; y: 8px; width: 23px; height: 20px; text: index == 0 ? "2m" : index == 1 ? "24m" : "1h"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

export component TransactionDrawer inherits AtlasDrawerFrame {
    in property <TransactionRecord> transaction;
    in-out property <bool> copied: false;
    label: "Sample transaction details";
    description: root.transaction.kind + " " + root.transaction.amount + " " + root.transaction.asset;
    side: DrawerSide.right;
    panel-width: 390px;
    backdrop-color: #27272245;
    panel-background: #f8f6f0;
    panel-border-width: 0px;
    panel-radius: 0px;
    panel-shadow-color: #00000044;
    panel-shadow-blur: 28px;
    panel-shadow-offset-x: -8px;
    dismiss-on-backdrop: true;
    dismissed => { root.open = false; }
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 84px; background: LedgerTheme.surface;
            SectionLabel { x: 22px; y: 17px; width: 290px; text: "SAMPLE TRANSACTION DETAILS"; }
            Text { x: 22px; y: 38px; width: 280px; height: 27px; text: root.transaction.status == "Confirmed" ? "CONFIRMED" : root.transaction.status == "Pending" ? "PENDING" : "FAILED"; color: root.transaction.tone == 0 ? LedgerTheme.positive : root.transaction.tone == 1 ? LedgerTheme.gold : LedgerTheme.negative; font-family: AtlasTypography.font-sans; font-size: 13px; font-weight: 650; letter-spacing: 1px; vertical-alignment: center; }
            AtlasIcon { x: parent.width - 37px; y: 31px; size: 13px; name: IconName.close; icon-color: LedgerTheme.muted; }
            close := ActionArea { x: parent.width - 50px; y: 18px; width: 42px; height: 42px; accessible-name: "Close transaction details"; activated => { root.open = false; } }
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border; }
        }
        Rectangle { x: 0px; y: 84px; width: parent.width; height: 130px; background: #f8f6f0;
            SectionLabel { x: 24px; y: 23px; width: 140px; text: root.transaction.kind; }
            Text { x: 24px; y: 43px; width: parent.width - 48px; height: 36px; text: root.transaction.amount; color: LedgerTheme.text; font-family: "Georgia"; font-size: 29px; vertical-alignment: center; }
            Text { x: parent.width - 84px; y: 52px; width: 60px; height: 20px; text: root.transaction.asset; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
            LedgerStatus { x: 24px; y: 88px; width: 92px; label: root.transaction.status; tone: root.transaction.tone; }
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border; }
        }
        Rectangle { x: 22px; y: 238px; width: parent.width - 44px; height: 521px;
            SectionLabel { x: 0px; y: 0px; width: parent.width; text: "FROM"; }
            Text { x: 0px; y: 17px; width: parent.width; height: 20px; text: "Demo Treasury"; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: 600; vertical-alignment: center; }
            AtlasCopyableValue { x: 0px; y: 41px; width: parent.width; height: 32px;
                value: "demo:account:source"; copied <=> root.copied;
                copy-requested(_) => { root.copied = true; }
                copy-label: "Copy source address"; background: #f0eee8;
                text-inset: 10px; action-width: 42px; icon-size: 11px; icon-right-inset: 16px; icon-offset-y: 10px;
                text-color: LedgerTheme.secondary; text-font-size: 9px;
                icon-color: LedgerTheme.muted; copied-color: LedgerTheme.positive;
            }
            SectionLabel { x: 0px; y: 94px; width: parent.width; text: "TO"; }
            Text { x: 0px; y: 111px; width: parent.width; height: 20px; text: root.transaction.party; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: 600; vertical-alignment: center; }
            AtlasCopyableValue { x: 0px; y: 135px; width: parent.width; height: 32px;
                value: root.transaction.address; copied <=> root.copied;
                copy-requested(_) => { root.copied = true; }
                copy-label: "Copy destination address"; background: #f0eee8;
                text-inset: 10px; action-width: 42px; icon-size: 11px; icon-right-inset: 16px; icon-offset-y: 10px;
                text-color: LedgerTheme.secondary; text-font-size: 9px;
                icon-color: LedgerTheme.muted; copied-color: LedgerTheme.positive;
            }
            SectionLabel { x: 0px; y: 192px; width: 140px; text: "NETWORK"; }
            Text { x: 0px; y: 210px; width: 140px; height: 20px; text: root.transaction.network; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 10px; vertical-alignment: center; }
            SectionLabel { x: 183px; y: 192px; width: 150px; text: "TIMESTAMP"; }
            Text { x: 183px; y: 210px; width: 150px; height: 35px; text: "Sep 1, 2026\n" + root.transaction.time; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; wrap: word-wrap; }
            SectionLabel { x: 0px; y: 266px; width: parent.width; text: "DEMO HASH"; }
            AtlasCopyableValue { x: 0px; y: 285px; width: parent.width; height: 36px;
                value: root.transaction.hash; copied <=> root.copied;
                copy-requested(_) => { root.copied = true; }
                copy-label: "Copy transaction hash"; background: #f0eee8;
                text-inset: 10px; action-width: 42px; icon-size: 11px; icon-right-inset: 16px; icon-offset-y: 12px;
                text-color: LedgerTheme.secondary; text-font-size: 9px;
                icon-color: LedgerTheme.muted; copied-color: LedgerTheme.positive;
            }
            SectionLabel { x: 0px; y: 347px; width: 160px; text: "SAMPLE BLOCK"; }
            Text { x: 0px; y: 365px; width: 160px; height: 22px; text: "24,812,244"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 10px; vertical-alignment: center; }
            SectionLabel { x: 183px; y: 347px; width: 160px; text: "SIMULATED FEE"; }
            Text { x: 183px; y: 365px; width: 160px; height: 22px; text: "$0.82"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 10px; vertical-alignment: center; }
            SectionLabel { x: 0px; y: 412px; width: 160px; text: "CONFIRMATIONS"; }
            Text { x: 0px; y: 430px; width: 160px; height: 22px; text: "42"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 10px; vertical-alignment: center; }
            SectionLabel { x: 183px; y: 412px; width: 160px; text: "REFERENCE"; }
            Text { x: 183px; y: 430px; width: 160px; height: 22px; text: "DEMO—0001"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 10px; vertical-alignment: center; }
        }
        Rectangle { x: 0px; y: parent.height - 66px; width: parent.width; height: 66px; background: #f5f3ed;
            Rectangle { width: parent.width; height: 1px; background: LedgerTheme.border; }
            LedgerButton { x: 22px; y: 16px; width: parent.width - 44px; text: "View Sample Data  →"; }
        }
}

component ModalField inherits Rectangle {
    in property <string> text;
    height: 37px; border-width: 1px; border-color: #cbc8c0; border-radius: 2px; background: #ffffff;
    Text { x: 10px; width: parent.width - 20px; text: root.text; color: LedgerTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 11px; vertical-alignment: center; overflow: elide; }
}

component ModalAction inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();
    height: 35px; border-width: 1px; border-color: root.primary ? #00000000 : LedgerTheme.border; border-radius: 2px;
    // The primary stays visually transparent to preserve the intended overlay hierarchy.
    background: root.primary ? #00000000 : #ffffff;
    Text { text: root.text; color: root.primary ? #00000000 : LedgerTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    action := ActionArea { accessible-name: root.text; activated => { root.clicked(); } }
}

export component TransferModal inherits AtlasModalFrame {
    in-out property <bool> review: false;
    callback cancelled();
    label: root.review ? "Review Transfer" : "New Transfer";
    description: "Fictional non-operational transfer workflow";
    panel-width: 500px;
    panel-height: root.review ? 509px : 536px;
    backdrop-color: #17181673;
    panel-border-width: 1px; panel-border-color: #d1cec6; panel-radius: 10px; panel-background: #ffffff; panel-clip: true;
    panel-shadow-color: #00000055; panel-shadow-blur: 34px; panel-shadow-offset-y: 12px;
    dismissed => { root.open = false; root.cancelled(); }

    Rectangle { x: 0px; y: 0px; width: parent.width; height: 85px; background: #ffffff;
        SectionLabel { x: 24px; y: 17px; width: parent.width - 70px; text: root.review ? "LEDGER / CONFIRMATION" : "LEDGER / TRANSFER"; }
        Text { x: 24px; y: 37px; width: parent.width - 70px; height: 27px; text: root.review ? "Review Transfer" : "New Transfer"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 20px; vertical-alignment: center; }
        AtlasIcon { x: parent.width - 39px; y: 29px; size: 13px; name: IconName.close; icon-color: LedgerTheme.muted; }
        close := ActionArea { x: parent.width - 53px; y: 14px; width: 43px; height: 43px; accessible-name: "Close transfer"; activated => { root.open = false; root.cancelled(); } }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border; }
    }
    if !root.review: Rectangle { x: 24px; y: 106px; width: parent.width - 48px; height: 350px;
        SectionLabel { width: parent.width; text: "FROM ACCOUNT"; color: LedgerTheme.secondary; }
        ModalField { x: 0px; y: 19px; width: parent.width; text: "Demo Treasury · $842,240 available                 ⌄"; }
        SectionLabel { x: 0px; y: 69px; width: parent.width; text: "TO ADDRESS / ACCOUNT"; color: LedgerTheme.secondary; }
        ModalField { x: 0px; y: 88px; width: parent.width; text: "Demo Settlement"; }
        SectionLabel { x: 0px; y: 138px; width: (parent.width - 10px) / 2; text: "ASSET"; color: LedgerTheme.secondary; }
        SectionLabel { x: (parent.width + 10px) / 2; y: 138px; width: (parent.width - 10px) / 2; text: "NETWORK"; color: LedgerTheme.secondary; }
        ModalField { x: 0px; y: 157px; width: (parent.width - 10px) / 2; text: "USDC                                             ⌄"; }
        ModalField { x: (parent.width + 10px) / 2; y: 157px; width: (parent.width - 10px) / 2; text: "Ethereum                                      ⌄"; }
        SectionLabel { x: 0px; y: 207px; width: parent.width; text: "AMOUNT"; color: LedgerTheme.secondary; }
        ModalField { x: 0px; y: 226px; width: parent.width; text: "24,000.00                                      USDC"; }
        Rectangle { x: 0px; y: 281px; width: parent.width; height: 56px; background: #f4f2ec;
            SectionLabel { x: 12px; y: 8px; width: 180px; text: "AVAILABLE BALANCE"; }
            Text { x: 12px; y: 25px; width: 190px; height: 20px; text: "240,000.00 USDC"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 600; vertical-alignment: center; }
            SectionLabel { x: 270px; y: 8px; width: 160px; text: "ESTIMATED FEE"; horizontal-alignment: right; }
            Text { x: 270px; y: 25px; width: 160px; height: 20px; text: "$0.82"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
        }
    }
    if root.review: Rectangle { x: 24px; y: 105px; width: parent.width - 48px; height: 321px;
        SectionLabel { x: 13px; y: 1px; width: parent.width - 26px; text: "YOU ARE SENDING"; horizontal-alignment: center; }
        Text { x: 0px; y: 23px; width: parent.width; height: 34px; text: "24,000.00  USDC"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 29px; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { x: 0px; y: 77px; width: parent.width; height: 65px; background: #efede7;
            SectionLabel { x: 0px; y: 0px; width: 150px; text: "FROM"; }
            Text { x: 0px; y: 18px; width: 170px; height: 22px; text: "Demo Treasury"; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: 650; vertical-alignment: center; }
            AtlasIcon { x: 217px; y: 20px; size: 14px; name: IconName.chevron-right; icon-color: LedgerTheme.gold; }
            SectionLabel { x: 282px; y: 0px; width: 170px; text: "TO"; horizontal-alignment: right; }
            Text { x: 272px; y: 18px; width: 180px; height: 22px; text: "Demo Settlement"; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 11px; font-weight: 650; horizontal-alignment: right; vertical-alignment: center; }
        }
        SectionLabel { x: 0px; y: 160px; width: 120px; text: "NETWORK"; }
        Text { x: parent.width - 190px; y: 157px; width: 190px; height: 20px; text: "Ethereum"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
        SectionLabel { x: 0px; y: 190px; width: 120px; text: "FEE"; }
        Text { x: parent.width - 190px; y: 187px; width: 190px; height: 20px; text: "$0.82"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
        SectionLabel { x: 0px; y: 220px; width: 120px; text: "TOTAL"; }
        Text { x: parent.width - 190px; y: 217px; width: 190px; height: 20px; text: "24,000.82 USDC"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
        Rectangle { x: 0px; y: 272px; width: parent.width; height: 42px; border-width: 1px; border-color: #d8d1bf; background: #f7f2e7;
            AtlasIcon { x: 11px; y: 14px; size: 13px; name: IconName.lock; icon-color: LedgerTheme.gold; }
            Text { x: 34px; width: parent.width - 45px; text: "This is a mock transfer. No financial operation will be performed."; color: LedgerTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 9px; vertical-alignment: center; }
        }
    }
    Rectangle { x: 0px; y: parent.height - 72px; width: parent.width; height: 72px; background: #ffffff;
        Rectangle { width: parent.width; height: 1px; background: LedgerTheme.border; }
        ModalAction { x: 24px; y: 18px; width: 78px; text: root.review ? "Back" : "Cancel"; clicked => { if (root.review) { root.review = false; } else { root.open = false; root.cancelled(); } } }
        ModalAction { x: parent.width - 151px; y: 18px; width: 127px; text: root.review ? "Confirm Transfer" : "Review Transfer"; primary: true; clicked => { if (root.review) { root.open = false; } else { root.review = true; } } }
    }
}
