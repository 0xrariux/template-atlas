import { AtlasIcon, IconName, AtlasTypography } from "@atlas-ui/stable.slint";
import { ActionArea } from "@atlas-ui/preview-nonresponsive.slint";
import { LedgerTheme } from "theme.slint";
import { AssetRecord } from "models.slint";
import { LedgerSurface, LedgerButton, SectionLabel, EditorialTitle, SummaryCell, LedgerChart, LedgerTabs, AssetMark, LedgerMeter, LedgerSearchField, PageHeading } from "components.slint";

component HoldingsRow inherits Rectangle {
    in property <AssetRecord> asset;
    height: 49px; background: action.hovered ? #f3f1eb : LedgerTheme.surface;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border-soft; }
    AssetMark { x: 13px; y: 10px; width: 29px; height: 29px; symbol: root.asset.symbol == "ETH" ? "E" : root.asset.symbol == "BTC" ? "B" : root.asset.symbol == "USDC" ? "U" : root.asset.symbol == "SOL" ? "S" : "L"; tone: root.asset.tone; }
    Text { x: 51px; y: 7px; width: parent.width * 0.10; height: 18px; text: root.asset.symbol; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 700; vertical-alignment: center; }
    Text { x: 51px; y: 24px; width: parent.width * 0.10; height: 15px; text: root.asset.name; color: LedgerTheme.muted; font-family: AtlasTypography.font-sans; font-size: 8px; vertical-alignment: center; }
    Text { x: parent.width * 0.19; y: 7px; width: parent.width * 0.11; height: 18px; text: root.asset.balance; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 600; vertical-alignment: center; }
    Text { x: parent.width * 0.19; y: 24px; width: parent.width * 0.11; height: 15px; text: root.asset.symbol; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; vertical-alignment: center; }
    Text { x: parent.width * 0.31; width: parent.width * 0.12; text: root.asset.price; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
    Text { x: parent.width * 0.44; width: parent.width * 0.13; text: root.asset.value; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; font-weight: 650; vertical-alignment: center; }
    Text { x: parent.width * 0.58; width: parent.width * 0.09; text: root.asset.change; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
    Text { x: parent.width * 0.68; y: 8px; width: parent.width * 0.09; height: 17px; text: root.asset.allocation; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
    LedgerMeter { x: parent.width * 0.68; y: 31px; width: parent.width * 0.08; value: root.asset.allocation-value / 10; meter-color: root.asset.tone == 0 ? #205c4d : root.asset.tone == 1 ? #557a68 : root.asset.tone == 2 ? #829b89 : root.asset.tone == 3 ? #b6924b : #c5ad79; }
    Rectangle { x: parent.width * 0.79; y: 15px; width: 74px; height: 19px; border-radius: 9px; background: #eeece5;
        Text { text: root.asset.network; color: LedgerTheme.secondary; font-family: AtlasTypography.font-sans; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
    }
    AtlasIcon { x: parent.width - 26px; y: 19px; size: 10px; name: IconName.chevron-right; icon-color: LedgerTheme.muted; }
    action := ActionArea { accessible-name: root.asset.symbol + " holding"; }
}

component HoldingsTable inherits LedgerSurface {
    in property <[AssetRecord]> assets;
    callback sort-assets(int);
    callback view-assets();
    height: 385px;
    clip: true;
    Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 66px;
        SectionLabel { x: 16px; y: 12px; width: 240px; text: "TREASURY ASSETS"; }
        Text { x: 16px; y: 29px; width: 240px; height: 24px; text: "Holdings"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 17px; vertical-alignment: center; }
        LedgerSearchField { x: parent.width - 337px; y: 17px; width: 175px; placeholder-text: "Search assets"; accessible-name: "Search holdings"; }
        LedgerButton { x: parent.width - 153px; y: 17px; width: 100px; text: "Filter"; show-icon: true; icon-name: IconName.filter; }
        LedgerButton { x: parent.width - 45px; y: 17px; width: 31px; text: "···"; }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border; }
    }
    Rectangle { x: 1px; y: 67px; width: parent.width - 2px; height: 31px; background: #efede7;
        Text { x: 13px; width: parent.width * 0.16; text: "ASSET"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600; vertical-alignment: center; }
        Text { x: parent.width * 0.19; width: parent.width * 0.11; text: "BALANCE"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600; vertical-alignment: center; }
        Text { x: parent.width * 0.31; width: parent.width * 0.12; text: "PRICE"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600; vertical-alignment: center; }
        Text { x: parent.width * 0.44; width: parent.width * 0.13; text: "VALUE"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600; vertical-alignment: center; }
        Text { x: parent.width * 0.58; width: parent.width * 0.09; text: "24H"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600; vertical-alignment: center; }
        Text { x: parent.width * 0.68; width: parent.width * 0.10; text: "ALLOCATION"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600; vertical-alignment: center; }
        Text { x: parent.width * 0.79; width: 80px; text: "NETWORK"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; font-weight: 600; vertical-alignment: center; }
        sort-symbol := ActionArea { x: 0px; width: parent.width * 0.18; accessible-name: "Sort holdings by asset"; activated => { root.sort-assets(0); } }
        sort-value := ActionArea { x: parent.width * 0.43; width: parent.width * 0.14; accessible-name: "Sort holdings by value"; activated => { root.sort-assets(1); } }
        sort-change := ActionArea { x: parent.width * 0.57; width: parent.width * 0.10; accessible-name: "Sort holdings by 24 hour change"; activated => { root.sort-assets(2); } }
    }
    for asset[index] in root.assets: HoldingsRow { x: 1px; y: 98px + index * 49px; width: parent.width - 2px; asset: asset; }
    Rectangle { x: 1px; y: 343px; width: parent.width - 2px; height: 41px; background: #f5f3ed;
        Text { x: 14px; text: "SIMULATED VALUES · DEMO ONLY"; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px; vertical-alignment: center; }
        Text { x: parent.width - 145px; width: 128px; text: "VIEW ALL ASSETS  ›"; color: LedgerTheme.green; font-family: AtlasTypography.font-mono; font-size: 8px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
        view-all := ActionArea { x: parent.width - 160px; width: 160px; accessible-name: "View all assets"; activated => { root.view-assets(); } }
    }
}

export component PortfolioPage inherits Rectangle {
    in property <[AssetRecord]> assets;
    in property <string> capture-state;
    callback transfer();
    callback sort-assets(int);
    callback view-assets();
    in-out property <int> period: root.capture-state == "portfolio-1y" ? 4 : 2;
    in-out property <int> chart-mode: root.capture-state == "portfolio-performance" ? 1 : 0;

    content := Rectangle {
        x: 27px;
        y: 30px;
        width: parent.width - 54px;
        height: 1160px;

        PageHeading { x: 0px; y: 0px; width: parent.width; eyebrow: "01 / TREASURY OVERVIEW"; title: "Portfolio"; subtitle: "Fictional consolidated treasury overview."; }
        Rectangle { x: parent.width - 132px; y: 8px; width: 132px; height: 45px;
            SectionLabel { x: 0px; y: 0px; width: parent.width; text: "DEMO DATA"; horizontal-alignment: right; }
            Rectangle { x: parent.width - 87px; y: 23px; width: 6px; height: 6px; border-radius: 999px; background: LedgerTheme.positive; }
            Text { x: parent.width - 75px; y: 16px; width: 75px; height: 20px; text: "SIMULATED"; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 8px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
        }

        LedgerSurface { x: 0px; y: 96px; width: parent.width; height: 164px;
            Rectangle { x: 0px; y: 0px; width: parent.width - 390px; height: parent.height; border-width: 0px;
                SectionLabel { x: 20px; y: 20px; width: 220px; text: "TOTAL PORTFOLIO VALUE"; }
                Rectangle { x: 237px; y: 15px; width: 51px; height: 24px; border-width: 1px; border-color: LedgerTheme.border; border-radius: 2px;
                    Text { x: 8px; width: 28px; text: "USD"; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 8px; vertical-alignment: center; }
                    AtlasIcon { x: 36px; y: 8px; size: 8px; name: IconName.chevron-down; icon-color: LedgerTheme.muted; }
                }
                Text { x: 20px; y: 46px; width: parent.width - 40px; height: 49px; text: "$1,284,420"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 37px; vertical-alignment: center; }
                Text { x: 237px; y: 58px; width: 75px; height: 35px; text: ".52"; color: LedgerTheme.secondary; font-family: "Georgia"; font-size: 20px; vertical-alignment: center; }
                SectionLabel { x: 20px; y: 113px; width: 28px; text: "24H"; }
                Text { x: 58px; y: 108px; width: 99px; height: 24px; text: "+$24,812.42"; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Text { x: 168px; y: 108px; width: 70px; height: 24px; text: "+1.97%"; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
            }
            Rectangle { x: parent.width - 390px; y: 1px; width: 230px; height: parent.height - 2px; border-width: 0px; background: #f5f1e7;
                Rectangle { x: 28px; y: 28px; width: 74px; height: 74px; border-width: 1px; border-color: #c9bfaa; }
                Rectangle { x: 57px; y: 57px; width: 16px; height: 16px; background: LedgerTheme.gold; }
                Text { x: 121px; y: 43px; width: 62px; height: 45px; text: "A"; color: #836e45; font-family: "Georgia"; font-size: 34px; horizontal-alignment: center; vertical-alignment: center; }
                SectionLabel { x: 113px; y: 91px; width: 80px; text: "ATLAS / NAV"; color: #927a4c; horizontal-alignment: center; }
            }
            Rectangle { x: parent.width - 160px; y: 1px; width: 159px; height: parent.height - 2px; background: #f7f5ef;
                LedgerButton { x: 20px; y: 38px; width: 120px; text: "Export"; show-icon: true; icon-name: IconName.download; }
                LedgerButton { x: 20px; y: 82px; width: 120px; text: "Transfer"; show-icon: true; icon-name: IconName.add; accent: true; clicked => { root.transfer(); } }
            }
        }

        LedgerSurface { x: 0px; y: 276px; width: parent.width; height: 85px;
            HorizontalLayout { width: parent.width; height: parent.height; spacing: 1px;
                SummaryCell { label: "NET ASSET VALUE"; value: "$1.284M"; detail: "100.0% of treasury"; }
                SummaryCell { label: "AVAILABLE"; value: "$842,180"; detail: "65.6% liquid"; }
                SummaryCell { label: "LOCKED"; value: "$318,240"; detail: "24.8% allocated"; }
                SummaryCell { label: "PENDING"; value: "$124,000"; detail: "9.6% in settlement"; }
            }
        }

        Rectangle { x: 0px; y: 376px; width: parent.width; height: 344px;
            LedgerSurface { x: 0px; y: 0px; width: (parent.width - 11px) * 0.70; height: parent.height;
                SectionLabel { x: 16px; y: 13px; width: 170px; text: "PORTFOLIO HISTORY"; }
                LedgerTabs { x: 16px; y: 33px; width: 212px; labels: ["Portfolio Value", "Performance"]; selected-index <=> root.chart-mode; }
                LedgerTabs { x: parent.width - 274px; y: 17px; width: 258px; labels: ["1D", "1W", "1M", "3M", "1Y", "ALL"]; selected-index <=> root.period; }
                Rectangle { x: 16px; y: 72px; width: parent.width - 32px; height: 42px; background: #f5f3ed;
                    SectionLabel { x: 11px; y: 6px; width: 70px; text: "24H HIGH"; }
                    Text { x: 11px; y: 20px; width: 70px; height: 17px; text: "$1.294M"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
                    Rectangle { x: 101px; y: 9px; width: 1px; height: 24px; background: LedgerTheme.border; }
                    SectionLabel { x: 117px; y: 6px; width: 70px; text: "24H LOW"; }
                    Text { x: 117px; y: 20px; width: 70px; height: 17px; text: "$1.241M"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
                    Rectangle { x: 208px; y: 9px; width: 1px; height: 24px; background: LedgerTheme.border; }
                    SectionLabel { x: 224px; y: 6px; width: 70px; text: "NET FLOW"; }
                    Text { x: 224px; y: 20px; width: 90px; height: 17px; text: "+$18,420"; color: LedgerTheme.positive; font-family: AtlasTypography.font-mono; font-size: 9px; vertical-alignment: center; }
                }
                for label[index] in ["$1.30M", "$1.25M", "$1.20M", "$1.15M"]: Text {
                    x: 14px; y: 118px + index * 57px; width: 45px; height: 16px;
                    text: label; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px;
                    horizontal-alignment: right; vertical-alignment: center;
                }
                LedgerChart { x: 71px; y: 126px; width: parent.width - 87px; height: 171px; alternate: root.period == 4 || root.chart-mode == 1; }
                for label[index] in ["AUG 01", "AUG 08", "AUG 15", "AUG 22", "SEP 01"]: Text {
                    x: 71px + index * (parent.width - 135px) / 4; y: 300px; width: 48px; height: 20px;
                    text: label; color: LedgerTheme.muted; font-family: AtlasTypography.font-mono; font-size: 7px;
                    horizontal-alignment: index == 0 ? left : index == 4 ? right : center;
                    vertical-alignment: center;
                }
            }
            LedgerSurface { x: (parent.width - 11px) * 0.70 + 11px; y: 0px; width: parent.width - self.x; height: parent.height;
                SectionLabel { x: 16px; y: 13px; width: parent.width - 32px; text: "ASSET ALLOCATION"; }
                Text { x: 16px; y: 30px; width: parent.width - 32px; height: 21px; text: "Portfolio composition"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 15px; vertical-alignment: center; }
                Rectangle { x: 21px; y: 73px; width: 102px; height: 102px; border-width: 16px; border-color: LedgerTheme.green; border-radius: 999px; background: #f3f0e9;
                    Text { y: 28px; width: parent.width; height: 25px; text: "5"; color: LedgerTheme.text; font-family: "Georgia"; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    SectionLabel { y: 51px; width: parent.width; text: "ASSETS"; horizontal-alignment: center; }
                }
                Rectangle { x: 145px; y: 63px; width: parent.width - 161px; height: 139px;
                    for asset[index] in root.assets: Rectangle { x: 0px; y: index * 22px; width: parent.width; height: 20px;
                        Rectangle { x: 0px; y: 7px; width: 6px; height: 6px; border-radius: 999px; background: asset.tone == 0 ? #205c4d : asset.tone == 1 ? #557a68 : asset.tone == 2 ? #829b89 : asset.tone == 3 ? #b6924b : #c5ad79; }
                        Text { x: 13px; width: 40px; text: asset.symbol; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 8px; font-weight: 650; vertical-alignment: center; }
                        Text { x: 54px; width: 42px; text: asset.allocation; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
                        LedgerMeter { x: 103px; y: 9px; width: parent.width - 103px; value: asset.allocation-value / 10; }
                    }
                    Rectangle { x: 0px; y: 110px; width: parent.width; height: 20px;
                        Rectangle { x: 0px; y: 7px; width: 6px; height: 6px; border-radius: 999px; background: #d7d2c8; }
                        Text { x: 13px; width: 40px; text: "OTHER"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 8px; font-weight: 650; vertical-alignment: center; }
                        Text { x: 54px; width: 42px; text: "3.8%"; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
                Rectangle { x: 16px; y: parent.height - 54px; width: parent.width - 32px; height: 38px; border-width: 1px; border-color: LedgerTheme.border-soft; background: #f5f3ed;
                    SectionLabel { x: 10px; y: 3px; width: 90px; text: "TOP ASSET"; }
                    Text { x: 10px; y: 17px; width: 100px; height: 16px; text: "ETHEREUM"; color: LedgerTheme.text; font-family: AtlasTypography.font-mono; font-size: 8px; font-weight: 650; vertical-alignment: center; }
                    Text { x: parent.width - 100px; width: 88px; text: "$424,536"; color: LedgerTheme.secondary; font-family: AtlasTypography.font-mono; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
        }

        HoldingsTable {
            x: 0px; y: 731px; width: parent.width; assets: root.assets;
            sort-assets(column) => { root.sort-assets(column); }
            view-assets => { root.view-assets(); }
        }
    }
}
