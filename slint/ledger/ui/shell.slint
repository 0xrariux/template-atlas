import { AtlasIcon, IconName, AtlasTypography } from "@atlas-ui/stable.slint";
import { ActionArea } from "@atlas-ui/preview-nonresponsive.slint";
import { LedgerTheme } from "theme.slint";
import { LedgerSearchField, SectionLabel } from "components.slint";

// L-01 "Folios": layered registers with a highlighted active spine.
// Built from primitives to remain readable and crisp in the compact shell header.
export component LedgerBrandMark inherits Rectangle {
    background: #00000000;

    Rectangle {
        x: 1px; y: 8px; width: 21px; height: 21px;
        border-width: 1px; border-color: #c79a4366; background: #00000000;
    }
    Rectangle {
        x: 5px; y: 4px; width: 21px; height: 21px;
        border-width: 1px; border-color: #c79a43a6; background: #00000000;
    }
    Rectangle {
        x: 9px; y: 0px; width: 21px; height: 21px;
        border-width: 1.5px; border-color: LedgerTheme.gold; background: #c79a4314;
        Rectangle { x: 3px; y: 0px; width: 3px; height: parent.height; background: LedgerTheme.gold; }
        Rectangle { x: 9px; y: 6px; width: 8px; height: 1px; background: LedgerTheme.gold; }
        Rectangle { x: 9px; y: 10px; width: 8px; height: 1px; background: LedgerTheme.gold; }
        Rectangle { x: 9px; y: 14px; width: 6px; height: 1px; background: LedgerTheme.gold; }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <IconName> icon-name;
    in property <bool> selected;
    callback clicked();
    height: 42px;
    border-radius: 2px;
    background: action.hovered ? #292d28 : #00000000;
    if root.selected: Rectangle { x: -11px; y: 10px; width: 2px; height: 21px; background: LedgerTheme.gold; }
    AtlasIcon { x: 12px; y: 12px; size: 14px; name: root.icon-name; icon-color: root.selected ? LedgerTheme.gold : #8f9990; }
    Text { x: 38px; width: parent.width - 55px; text: root.label; color: root.selected ? #ffffff : #8d9189; font-family: AtlasTypography.font-sans; font-size: 12px; font-weight: root.selected ? 650 : 500; vertical-alignment: center; }
    if root.selected: Rectangle { x: parent.width - 12px; y: 19px; width: 4px; height: 4px; border-radius: 999px; background: LedgerTheme.gold; }
    action := ActionArea { selected: root.selected; accessible-name: root.label; activated => { root.clicked(); } }
}

export component LedgerSidebar inherits Rectangle {
    in-out property <int> current-page: 0;
    callback navigate(int);
    width: LedgerTheme.sidebar-width;
    background: LedgerTheme.sidebar;

    Rectangle { x: 0px; y: 0px; width: parent.width; height: 84px; background: #20231f;
        LedgerBrandMark { x: 22px; y: 27px; width: 31px; height: 29px; }
        Text { x: 67px; y: 20px; height: 18px; text: "ATLAS"; color: #f1efe8; font-family: AtlasTypography.font-display; font-size: 13px; font-weight: 700; letter-spacing: 2px; vertical-alignment: center; }
        Text { x: 67px; y: 39px; height: 15px; text: "LEDGER"; color: #929a92; font-family: AtlasTypography.font-mono; font-size: 11px; font-weight: 600; letter-spacing: 2px; vertical-alignment: center; }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.sidebar-rule; }
    }

    Rectangle { x: 13px; y: 102px; width: parent.width - 26px; height: 73px;
        SectionLabel { x: 8px; y: 0px; width: parent.width - 16px; text: "ACTIVE BOOK"; color: #697369; }
        Rectangle { x: 0px; y: 21px; width: parent.width; height: 50px; border-width: 1px; border-color: #3a3e38; border-radius: 2px; background: #252924;
            Rectangle { x: 9px; y: 9px; width: 28px; height: 28px; border-radius: 2px; background: #39594e;
                Text { text: "MT"; color: #f0eee7; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { x: 47px; y: 7px; width: parent.width - 72px; height: 17px; text: "Demo Treasury"; color: #e5e5df; font-family: AtlasTypography.font-sans; font-size: 12px; font-weight: 600; vertical-alignment: center; }
            Text { x: 47px; y: 25px; width: parent.width - 72px; height: 15px; text: "USD · Consolidated"; color: #7b837a; font-family: AtlasTypography.font-sans; font-size: 10px; vertical-alignment: center; }
            AtlasIcon { x: parent.width - 19px; y: 19px; size: 9px; name: IconName.chevron-down; icon-color: #788078; }
        }
    }

    SectionLabel { x: 23px; y: 198px; width: parent.width - 46px; text: "FINANCE"; color: #646d64; }
    NavItem { x: 11px; y: 219px; width: parent.width - 22px; label: "Portfolio"; icon-name: IconName.grid; selected: root.current-page == 0; clicked => { root.current-page = 0; root.navigate(0); } }
    NavItem { x: 11px; y: 261px; width: parent.width - 22px; label: "Assets"; icon-name: IconName.database; selected: root.current-page == 1; clicked => { root.current-page = 1; root.navigate(1); } }
    NavItem { x: 11px; y: 303px; width: parent.width - 22px; label: "Transactions"; icon-name: IconName.logs; selected: root.current-page == 2; clicked => { root.current-page = 2; root.navigate(2); } }
    NavItem { x: 11px; y: 345px; width: parent.width - 22px; label: "Markets"; icon-name: IconName.analytics; selected: root.current-page == 3; clicked => { root.current-page = 3; root.navigate(3); } }
    NavItem { x: 11px; y: 387px; width: parent.width - 22px; label: "Accounts"; icon-name: IconName.users; selected: root.current-page == 4; clicked => { root.current-page = 4; root.navigate(4); } }
    NavItem { x: 11px; y: 429px; width: parent.width - 22px; label: "Analytics"; icon-name: IconName.activity; selected: root.current-page == 5; clicked => { root.current-page = 5; root.navigate(5); } }

    SectionLabel { x: 23px; y: 493px; width: parent.width - 46px; text: "MANAGE"; color: #646d64; }
    NavItem { x: 11px; y: 514px; width: parent.width - 22px; label: "Connections"; icon-name: IconName.globe; selected: root.current-page == 6; clicked => { root.current-page = 6; root.navigate(6); } }
    NavItem { x: 11px; y: 556px; width: parent.width - 22px; label: "Security"; icon-name: IconName.shield; selected: root.current-page == 7; clicked => { root.current-page = 7; root.navigate(7); } }
    NavItem { x: 11px; y: 598px; width: parent.width - 22px; label: "Settings"; icon-name: IconName.settings; selected: root.current-page == 8; clicked => { root.current-page = 8; root.navigate(8); } }

    Rectangle { x: 13px; y: parent.height - 127px; width: parent.width - 26px; height: 109px; border-width: 1px; border-color: #363b35; border-radius: 2px; background: #242824;
        SectionLabel { x: 10px; y: 10px; width: parent.width - 20px; text: "DEMO TREASURY"; color: #717a71; }
        Rectangle { x: 10px; y: 32px; width: 6px; height: 6px; border-radius: 999px; background: #65a48a; }
        Text { x: 23px; y: 25px; height: 20px; text: "Connected"; color: #d3d7d1; font-family: AtlasTypography.font-sans; font-size: 10px; font-weight: 600; vertical-alignment: center; }
        Text { x: 10px; y: 46px; width: parent.width - 20px; height: 14px; text: "Multi-network custody"; color: #7a827a; font-family: AtlasTypography.font-sans; font-size: 8px; vertical-alignment: center; }
        Rectangle { x: 10px; y: 67px; width: parent.width - 20px; height: 1px; background: #393e38; }
        Text { x: 10px; y: 72px; height: 13px; text: "4 ACCOUNTS"; color: #727b72; font-family: AtlasTypography.font-mono; font-size: 7px; vertical-alignment: center; }
        Text { x: parent.width - 34px; y: 72px; width: 24px; height: 13px; text: "USD"; color: LedgerTheme.gold; font-family: AtlasTypography.font-mono; font-size: 7px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

export component LedgerTopbar inherits Rectangle {
    callback notification-clicked();
    height: LedgerTheme.topbar-height;
    background: #f8f7f2;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: LedgerTheme.border; }
    search := LedgerSearchField { x: 24px; y: 15px; width: min(400px, parent.width * 0.36); height: 39px; placeholder-text: "Search sample assets or demo references"; right-inset: 55px; accessible-name: "Search Ledger"; }
    Rectangle { x: search.x + search.width - 46px; y: 23px; width: 36px; height: 17px; border-width: 1px; border-color: LedgerTheme.border; border-radius: 2px; background: #efede7;
        Text { text: "⌘ K"; color: #81817b; font-family: AtlasTypography.font-mono; font-size: 7px; horizontal-alignment: center; vertical-alignment: center; }
    }
    network-control := Rectangle { x: parent.width - 482px; y: 11px; width: 150px; height: 43px;
        border-width: 1px;
        border-color: network-action.has-hover ? LedgerTheme.border : #00000000;
        border-radius: 2px;
        background: network-action.pressed ? LedgerTheme.surface-secondary : network-action.has-hover ? #efede7 : #00000000;
        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }
        SectionLabel { x: 8px; y: 0px; width: parent.width - 16px; text: "NETWORK"; }
        Text { x: 8px; y: 18px; width: parent.width - 26px; height: 20px; text: "All Demo Networks"; color: network-action.has-hover ? LedgerTheme.green : LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 600; vertical-alignment: center; }
        AtlasIcon { x: parent.width - 14px; y: 24px; size: 9px; name: IconName.chevron-down; icon-color: network-action.has-hover ? LedgerTheme.green : LedgerTheme.muted; }
        network-action := TouchArea { mouse-cursor: MouseCursor.pointer; }
    }
    Rectangle { x: parent.width - 315px; y: 16px; width: 32px; height: 32px; border-width: 1px; border-color: info-action.has-hover ? LedgerTheme.green : LedgerTheme.border; border-radius: 2px; background: info-action.pressed ? LedgerTheme.surface-secondary : info-action.has-hover ? LedgerTheme.green-soft : LedgerTheme.surface;
        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }
        AtlasIcon { x: 9px; y: 9px; size: 14px; name: IconName.info; icon-color: info-action.has-hover ? LedgerTheme.green : LedgerTheme.secondary; }
        info-action := TouchArea { mouse-cursor: MouseCursor.pointer; }
    }
    Rectangle { x: parent.width - 275px; y: 16px; width: 32px; height: 32px; border-width: 1px; border-color: notify-action.has-hover ? LedgerTheme.green : LedgerTheme.border; border-radius: 2px; background: notify-action.pressed ? LedgerTheme.surface-secondary : notify-action.has-hover ? LedgerTheme.green-soft : LedgerTheme.surface;
        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }
        AtlasIcon { x: 9px; y: 9px; size: 14px; name: IconName.bell; icon-color: notify-action.has-hover ? LedgerTheme.green : LedgerTheme.secondary; }
        Rectangle { x: 22px; y: 5px; width: 5px; height: 5px; border-radius: 999px; background: LedgerTheme.gold; }
        accessible-role: AccessibleRole.button;
        accessible-label: "Notifications";
        accessible-action-default => { root.notification-clicked(); }
        notify-action := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.notification-clicked(); } }
    }
    profile-control := Rectangle { x: parent.width - 230px; y: 11px; width: 213px; height: 43px;
        border-width: 1px;
        border-color: profile-action.has-hover ? LedgerTheme.border : #00000000;
        border-radius: 2px;
        background: profile-action.pressed ? LedgerTheme.surface-secondary : profile-action.has-hover ? #efede7 : #00000000;
        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }
        Rectangle { x: 0px; y: 5px; width: 32px; height: 32px; border-radius: 999px; background: #31584c;
            Text { text: "DA"; color: #f5f3ed; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { x: 43px; y: 4px; width: 145px; height: 18px; text: "Demo Administrator"; color: LedgerTheme.text; font-family: AtlasTypography.font-sans; font-size: 9px; font-weight: 600; vertical-alignment: center; }
        Text { x: 43px; y: 22px; width: 145px; height: 15px; text: "Sample workspace"; color: LedgerTheme.muted; font-family: AtlasTypography.font-sans; font-size: 8px; vertical-alignment: center; }
        AtlasIcon { x: parent.width - 12px; y: 18px; size: 9px; name: IconName.chevron-down; icon-color: profile-action.has-hover ? LedgerTheme.green : LedgerTheme.muted; }
        profile-action := TouchArea { mouse-cursor: MouseCursor.pointer; }
    }
}
